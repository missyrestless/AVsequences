//nfo_preprocessor_version 0
//program_version LSL PyOptimizer v0.3.0beta
//mono

key gE;
integer LslLibrary;
integer IsSaveDue;
integer Pop;
list edefaultstate_entry = ["ALL", "OWNER", "GROUP"];
integer ResumeVoid;
integer g_;
string UThreadStackFrame;
list gD = [UThreadStackFrame];

integer _(key llGetNumberOfPrims, string llGetInventoryType)
{
    integer loc_ALLOWED;
    string loc_TYPE = llList2String(edefaultstate_entry, ResumeVoid);
    if (llGetInventoryType == "MENU")
    {
        loc_TYPE = llList2String(gD, g_);
    }
    if (loc_TYPE == "GROUP")
    {
        if (!~-llSameGroup(llGetNumberOfPrims))
        {
            loc_ALLOWED = 1;
        }
    }
    else if (llGetNumberOfPrims == llGetOwner() | loc_TYPE == "ALL")
    {
        loc_ALLOWED = 1;
    }
    return loc_ALLOWED;
}

A()
{
    integer loc_i = llGetNumberOfPrims();
    while (!(llGetAgentSize(llGetLinkKey(loc_i)) == <((float)0), ((float)0), ((float)0)>))
    {
        key loc_av = llGetLinkKey(loc_i);
        if (!_(loc_av, "SIT"))
        {
            llUnSit(loc_av);
            llDialog(loc_av, "AVsitter™ Security 2.2p04\n\nSorry, Sit access is set to: " + llList2String(edefaultstate_entry, ResumeVoid), [], ((integer)-164289491));
        }
        --loc_i;
    }
}

list B(list llGetNumberOfPrims)
{
    return llList2List(llGetNumberOfPrims, ((integer)-3), ((integer)-1)) + llList2List(llGetNumberOfPrims, ((integer)-6), ((integer)-4)) + llList2List(llGetNumberOfPrims, ((integer)-9), ((integer)-7)) + llList2List(llGetNumberOfPrims, ((integer)-12), ((integer)-10));
}

C(key llGetNumberOfPrims, integer llGetInventoryType, integer llDialog, integer llRegionSayTo)
{
    if (_(llGetNumberOfPrims, "MENU"))
    {
        if (llGetInventoryType("[AV]root-control") ^ 10)
        {
            llMessageLinked(((integer)-1), 90005, (string)llGetInventoryType, llGetNumberOfPrims);
        }
        else
        {
            if (F())
            {
                llMessageLinked(((integer)-4), 90012, (string)llDialog, llGetNumberOfPrims);
            }
            else
            {
                llMessageLinked(((integer)-4), 90007, "", llGetNumberOfPrims);
            }
        }
    }
    else if (llRegionSayTo)
    {
        llDialog(llGetNumberOfPrims, "AVsitter™ Security 2.2p04\n\nSorry, Menu access is set to: " + llList2String(gD, g_), [], ((integer)-164289491));
    }
}

D()
{
    list loc_buttons = (list)"Sit" + "Menu";
    if (gE)
    {
        loc_buttons = "[BACK]" + loc_buttons;
    }
    E("Sit access: " + llList2String(edefaultstate_entry, ResumeVoid) + "\nMenu access: " + llList2String(gD, g_) + "\n\nChange security settings:", loc_buttons);
    UThreadStackFrame = "";
}

E(string llGetNumberOfPrims, list llGetInventoryType)
{
    llListenRemove(Pop);
    Pop = llListen(IsSaveDue = ~(integer)llFrand(2147483520), "", llGetOwner(), "");
    llDialog(llGetOwner(), "AVsitter™ Security 2.2p04\n\n" + llGetNumberOfPrims, B(llGetInventoryType), IsSaveDue);
    llSetTimerEvent(600);
}

integer F()
{
    if (llGetInventoryType("[AV]root-RLV") == 10)
    {
        return 1;
    }
    return 0;
}

default
{
    state_entry()
    {
        gD = edefaultstate_entry;
        llMessageLinked(((integer)-1), 90202, (string)F(), "");
    }

    timer()
    {
        llSetTimerEvent(0);
        llListenRemove(Pop);
    }

    link_message(integer llGetNumberOfPrims, integer llGetInventoryType, string llDialog, key llRegionSayTo)
    {
        if (llGetInventoryType ^ 90201)
            if (llGetInventoryType ^ 90006)
                if (llGetInventoryType ^ 90100)
                {
                    if (llGetInventoryType == 90033)
                    {
                        llListenRemove(Pop);
                    }
                }
                else
                {
                    list loc_data = llParseString2List(llDialog, (list)"|", []);
                    if (llList2String(loc_data, 1) == "[SECURITY]")
                    {
                        if (llRegionSayTo == llGetOwner())
                        {
                            LslLibrary = llList2Integer(loc_data, 0);
                            gE = llList2Key(loc_data, 2);
                            D();
                        }
                        else
                        {
                            llRegionSayTo(llRegionSayTo, 0, "Sorry, only the owner can change security settings.");
                            llMessageLinked(llGetNumberOfPrims, 90101, llList2String(loc_data, 0) + "|[ADJUST]|" + (string)llRegionSayTo, llList2Key(loc_data, 2));
                        }
                    }
                }
            else
            {
                if (llGetInventoryType("[AV]root-control") ^ 10)
                {
                    C(llRegionSayTo, (integer)llDialog, llGetNumberOfPrims, 0);
                }
            }
        else
        {
            llMessageLinked(((integer)-1), 90202, (string)F(), "");
        }
    }

    listen(integer llGetNumberOfPrims, string llGetInventoryType, key llDialog, string llRegionSayTo)
    {
        if (llRegionSayTo == "Sit")
        {
            E("Sit security:", edefaultstate_entry);
            UThreadStackFrame = llRegionSayTo;
            return;
        }
        else if (llRegionSayTo == "Menu")
        {
            E("Menu security:", gD);
            UThreadStackFrame = llRegionSayTo;
            return;
        }
        else
        {
            if (llRegionSayTo == "[BACK]")
            {
                llMessageLinked(((integer)-1), 90101, (string)LslLibrary + "|[ADJUST]|" + (string)llDialog, gE);
            }
            else if (UThreadStackFrame == "Sit")
            {
                ResumeVoid = llListFindList(edefaultstate_entry, (list)llRegionSayTo);
                D();
                A();
                return;
            }
            else if (UThreadStackFrame == "Menu")
            {
                g_ = llListFindList(gD, (list)llRegionSayTo);
                D();
                return;
            }
        }
        llListenRemove(Pop);
    }

    changed(integer llGetNumberOfPrims)
    {
        if (llGetNumberOfPrims & 32)
        {
            A();
        }
    }

    touch_end(integer llGetNumberOfPrims)
    {
        if (F() | !(llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>))
        {
            C(llDetectedKey(0), 0, llDetectedLinkNumber(0), 1);
        }
    }
}
