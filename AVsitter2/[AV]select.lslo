integer edefaultlink_message;
list gA;
integer LslUserScript = -1;
key gB;
key Library;
string ResumeVoid;
list UThread;
list UThreadStackFrame = [ResumeVoid];
integer edefaultstate_entry;
integer edefaultchat;
integer System;

_(integer llGetScriptName, string llGetSubString)
{
    if (llGetScriptName < 1)
    {
        llOwnerSay(llGetScriptName() + "[2.2p04] " + llGetSubString);
    }
}

string A(string llGetScriptName, string llGetSubString, string llList2Integer)
{
    return llDumpList2String(llParseStringKeepNulls(llGetScriptName, (list)llGetSubString, []), llList2Integer);
}

list B(list llGetScriptName)
{
    return llList2List(llGetScriptName, ((integer)-3), ((integer)-1)) + llList2List(llGetScriptName, ((integer)-6), ((integer)-4)) + llList2List(llGetScriptName, ((integer)-9), ((integer)-7)) + llList2List(llGetScriptName, ((integer)-12), ((integer)-10));
}

C(key llGetScriptName)
{
    integer loc_sitter_index = llListFindList(UThread, (list)llGetScriptName);
    if (~loc_sitter_index)
    {
        list loc_menu_buttons;
        integer loc_i;
        for (loc_i = 0; loc_i < (gA != []); ++loc_i)
        {
            string loc_avname = llKey2Name(llList2Key(UThread, loc_i));
            if ((edefaultlink_message | llList2Integer(UThreadStackFrame, loc_i)) & -!(edefaultlink_message == 2) | loc_avname == "" | llGetScriptName == llList2Key(UThread, loc_i))
            {
                loc_menu_buttons = loc_menu_buttons + llList2String(gA, loc_i);
            }
            else
            {
                loc_menu_buttons = loc_menu_buttons + ("⊘" + llGetSubString(A(loc_avname, " Resident", " "), 0, 11));
            }
        }
        while ((-~(loc_menu_buttons != [])) % 3)
        {
            loc_menu_buttons = loc_menu_buttons + " ";
        }
        loc_menu_buttons = loc_menu_buttons + "[ADJUST]";
        llListenControl(edefaultchat, 1);
        llDialog(llGetScriptName, "AVsitter™ seat select 2.2p04\n\n" + ResumeVoid + "[" + llList2String(gA, loc_sitter_index) + "]", B(loc_menu_buttons), edefaultstate_entry);
    }
}

integer D()
{
    integer loc_i = 1;
    while (llGetInventoryType("[AV]sitA " + (string)loc_i) == 10)
    {
        ++loc_i;
    }
    return loc_i;
}

default
{
    state_entry()
    {
        edefaultstate_entry = ~(integer)llFrand(2147483520);
        edefaultchat = llListen(edefaultstate_entry, "", "", "");
        llListenControl(edefaultchat, 0);
        integer loc_i;
        UThreadStackFrame = [];
        for (loc_i = 0; loc_i < D(); ++loc_i)
        {
            UThread = UThread + "00000000-0000-0000-0000-000000000000";
            UThreadStackFrame = UThreadStackFrame + 0;
            gA = gA + ("Sitter " + (string)loc_i);
        }
        gB = llGetInventoryKey("AVpos");
        _(0, "Loading...");
        Library = llGetNotecardLine("AVpos", System);
    }

    listen(integer llGetScriptName, string llGetSubString, key llList2Integer, string llParseString2List)
    {
        integer loc_av_index = llListFindList(UThread, (list)llList2Integer);
        integer loc_button_index = llListFindList(gA, (list)llParseString2List);
        if (~loc_av_index)
        {
            if (llParseString2List == "[ADJUST]" | llParseString2List == "[HELPER]")
            {
                llMessageLinked(((integer)-1), 90101, "X|" + (llParseString2List + ("|" + (string)llList2Integer)), llList2Integer);
            }
            else if (-!(llGetSubString(llParseString2List, 0, 0) == "⊘") & (edefaultlink_message | llList2Integer(UThreadStackFrame, loc_button_index) | llList2Key(UThread, loc_button_index) == "00000000-0000-0000-0000-000000000000" | llList2Key(UThread, loc_button_index) == llList2Integer))
            {
                if (~loc_button_index)
                {
                    llMessageLinked(((integer)-1), 90030, (string)loc_av_index, (string)loc_button_index);
                }
            }
            else
            {
                C(llList2Integer);
            }
        }
    }

    changed(integer llGetScriptName)
    {
        if (llGetScriptName & 1)
        {
            if (!(llGetInventoryKey("AVpos") == gB & D() == (UThread != [])))
            {
                llResetScript();
            }
        }
        if (llGetScriptName & 32)
        {
            if (llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>)
            {
                llListenControl(edefaultchat, 0);
            }
        }
    }

    link_message(integer llGetScriptName, integer llGetSubString, string llList2Integer, key llParseString2List)
    {
        if (llGetScriptName == llGetLinkNumber())
        {
            if (llGetSubString ^ 90055)
                if (llGetSubString ^ 90065)
                    if (llGetSubString ^ 90030)
                        if (llGetSubString ^ 90070)
                        {
                            if (llGetSubString == 90009)
                            {
                                C(llParseString2List);
                            }
                        }
                        else
                        {
                            UThread = llListReplaceList(UThread, (list)llParseString2List, (integer)llList2Integer, (integer)llList2Integer);
                        }
                    else
                    {
                        UThread = llListReplaceList(UThread, (list)"00000000-0000-0000-0000-000000000000", (integer)llList2Integer, (integer)llList2Integer);
                        UThread = llListReplaceList(UThread, (list)"00000000-0000-0000-0000-000000000000", (integer)((string)llParseString2List), (integer)((string)llParseString2List));
                    }
                else
                {
                    integer loc_index = llListFindList(UThread, (list)llParseString2List);
                    if (~loc_index)
                    {
                        UThread = llListReplaceList(UThread, (list)"00000000-0000-0000-0000-000000000000", loc_index, loc_index);
                    }
                }
            else
            {
                list loc_data = llParseStringKeepNulls(llParseString2List, (list)"|", []);
                if (llGetSubString(llList2String(loc_data, 0), 0, 1) == "P:")
                {
                    UThreadStackFrame = llListReplaceList(UThreadStackFrame, (list)0, (integer)llList2Integer, (integer)llList2Integer);
                }
                else
                {
                    UThreadStackFrame = llListReplaceList(UThreadStackFrame, (list)1, (integer)llList2Integer, (integer)llList2Integer);
                }
            }
        }
    }

    dataserver(key llGetScriptName, string llGetSubString)
    {
        if (llGetScriptName == Library)
        {
            if (llGetSubString == "\n\n\n")
            {
                _(0, "Ready");
            }
            else
            {
                llGetSubString = llGetSubString(llGetSubString, -~llSubStringIndex(llGetSubString, "◆"), 99999);
                llGetSubString = llStringTrim(llGetSubString, 3);
                string loc_command = llGetSubString(llGetSubString, 0, ~-llSubStringIndex(llGetSubString, " "));
                list loc_parts = llParseString2List(llGetSubString(llGetSubString, -~llSubStringIndex(llGetSubString, " "), 99999), (list)" | " + " |" + "| " + "|", []);
                string loc_part0 = llList2String(loc_parts, 0);
                if (loc_command == "TEXT")
                {
                    ResumeVoid = A(loc_part0, "\\n", "\n") + "\n";
                }
                else if (loc_command == "SITTER")
                {
                    LslUserScript = (integer)loc_part0;
                    string loc_button_text = llList2String(loc_parts, 1);
                    if (LslUserScript < (UThread != []))
                    {
                        if (!(loc_button_text == "" | ~llListFindList(gA, (list)loc_button_text)))
                        {
                            gA = llListReplaceList(gA, (list)loc_button_text, LslUserScript, LslUserScript);
                            LslUserScript = ((integer)-1);
                        }
                    }
                }
                else if (!(loc_command == "MTYPE"))
                    if (loc_command == "SELECT")
                    {
                        edefaultlink_message = (integer)loc_part0;
                    }
                    else if (loc_command == "POSE" | loc_command == "SYNC")
                    {
                        if (-(LslUserScript < (UThread != [])) & ~LslUserScript)
                        {
                            if (llList2String(gA, LslUserScript) == "Sitter " + (string)LslUserScript)
                            {
                                loc_part0 = llGetSubString(loc_part0, 0, 22);
                                if (!~llListFindList(gA, (list)loc_part0))
                                {
                                    gA = llListReplaceList(gA, (list)loc_part0, LslUserScript, LslUserScript);
                                }
                            }
                            else
                            {
                                gA = llListReplaceList(gA, (list)("Sitter " + (string)LslUserScript), LslUserScript, LslUserScript);
                                LslUserScript = ((integer)-1);
                            }
                        }
                    }
                Library = llGetNotecardLine("AVpos", ++System);
            }
        }
    }
}
