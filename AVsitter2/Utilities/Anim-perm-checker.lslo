//nfo_preprocessor_version 0
//program_version LSL PyOptimizer v0.3.0beta
//mono

_(string llGetInventoryName)
{
    llOwnerSay(llGetScriptName() + ": " + llGetInventoryName);
}

default
{
    state_entry()
    {
        integer loc_copy_trans_count;
        integer loc_copy_count;
        integer loc_trans_count;
        _(" ");
        _("================================");
        integer loc_total = llGetInventoryNumber(20);
        _("Checking NEXT_OWNER permissions of ANIMATIONS.");
        integer loc_i;
        for (loc_i = 0; loc_i < loc_total; ++loc_i)
        {
            string loc_item = llGetInventoryName(20, loc_i);
            integer loc_perms = llGetInventoryPermMask(loc_item, 4);
            if (loc_perms & 32768)
            {
                if (loc_perms & 8192)
                {
                    _(loc_item + " is COPY-TRANSFER!");
                    ++loc_copy_trans_count;
                }
                else
                {
                    ++loc_copy_count;
                }
            }
            else if (loc_perms & 8192)
            {
                ++loc_trans_count;
            }
        }
        _((string)loc_total + " anims total");
        _((string)loc_trans_count + " anims are TRANSFER");
        _((string)loc_copy_count + " anims are COPY.");
        _((string)loc_copy_trans_count + " anims are COPY-TRANSFER!");
        _("Check complete, removing script.");
        _("================================");
        _(" ");
        if (!~llSubStringIndex(llGetObjectName(), "Utilities"))
        {
            llRemoveInventory(llGetScriptName());
        }
    }
}
