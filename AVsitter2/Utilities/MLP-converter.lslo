//nfo_preprocessor_version 0
//program_version LSL PyOptimizer v0.3.0beta
//mono

string IsSaveDue;
list edefaultdataserver = [IsSaveDue];
list gB;
key gA;
integer gC;
integer System;
integer UThreadStackFrame;
integer gD;
list Pop = ["default", "stand"];

_(integer llParseString2List, string llGetInventoryNumber)
{
    if (llParseString2List < 1)
    {
        llOwnerSay(llGetScriptName() + "[2.2p04] " + llGetInventoryNumber);
    }
}

string A(float llParseString2List, integer llGetInventoryNumber)
{
    float loc_rounding = ((float)-5e-07) + (float)(".5e-" + (string)llGetInventoryNumber);
    if (llParseString2List < ((float)0))
        llParseString2List = llParseString2List + -loc_rounding;
    else
        llParseString2List = llParseString2List + loc_rounding;
    string loc_ret = llGetSubString((string)llParseString2List, 0, ((integer)-7) + (llGetInventoryNumber + -!llGetInventoryNumber));
    if (~llSubStringIndex(loc_ret, "."))
    {
        while (llGetSubString(loc_ret, ((integer)-1), ((integer)-1)) == "0")
        {
            loc_ret = llGetSubString(loc_ret, 0, ((integer)-2));
        }
    }
    if (llGetSubString(loc_ret, ((integer)-1), ((integer)-1)) == ".")
    {
        loc_ret = llGetSubString(loc_ret, 0, ((integer)-2));
    }
    return loc_ret;
}

B()
{
    if (!~llSubStringIndex(llGetObjectName(), "Utilities"))
    {
        _(0, "Removing script");
        llRemoveInventory(llGetScriptName());
    }
}

C()
{
    integer loc_i;
    for (loc_i = 0; loc_i < llGetInventoryNumber(7); ++loc_i)
    {
        string loc_name = llGetInventoryName(7, loc_i);
        if (llGetSubString(loc_name, 0, 9) == ".MENUITEMS" | llGetSubString(loc_name, 0, 9) == ".POSITIONS")
        {
            edefaultdataserver = edefaultdataserver + loc_name;
        }
        else if (llGetSubString(loc_name, 0, 5) == ".PROPS")
        {
            gB = gB + loc_name;
        }
    }
}

D(string llParseString2List)
{
    string loc_objectname = llGetObjectName();
    llSetObjectName("");
    llRegionSayTo(llGetOwner(), 0, "◆" + llParseString2List);
    llSetObjectName(loc_objectname);
}

default
{
    state_entry()
    {
        _(0, "Reading MLP notecards...");
        D(" ");
        edefaultdataserver = [];
        C();
        if (0 < (edefaultdataserver != []))
        {
            IsSaveDue = llList2String(edefaultdataserver, System);
            D("--✄--COPY BELOW INTO AVpos NOTECARD--✄--");
            D(" ");
            D("SITTER " + (string)UThreadStackFrame);
            gA = llGetNotecardLine(IsSaveDue, gC);
        }
        else
        {
            _(0, "No MLP notecards found!");
            B();
        }
    }

    dataserver(key llParseString2List, string llGetInventoryNumber)
    {
        if (llParseString2List == gA)
        {
            if (llGetInventoryNumber == "\n\n\n")
            {
                if (1 < (edefaultdataserver != []) + -System)
                {
                    IsSaveDue = llList2String(edefaultdataserver, ++System);
                    gA = llGetNotecardLine(IsSaveDue, gC = 0);
                }
                else if (-~UThreadStackFrame < gD)
                {
                    ++UThreadStackFrame;
                    D(" ");
                    D("SITTER " + (string)UThreadStackFrame);
                    IsSaveDue = llList2String(edefaultdataserver, System = 0);
                    gA = llGetNotecardLine(IsSaveDue, gC = 0);
                }
                else
                {
                    D(" ");
                    D("--✄--COPY ABOVE INTO AVpos NOTECARD--✄--");
                    B();
                }
            }
            else
            {
                string loc_out;
                llGetInventoryNumber = llStringTrim(llList2String(llParseString2List(llGetInventoryNumber, (list)"//", []), 0), 3);
                if (llGetSubString(IsSaveDue, 0, 9) == ".MENUITEMS")
                {
                    string loc_command = llGetSubString(llGetInventoryNumber, 0, ~-llSubStringIndex(llGetInventoryNumber, " "));
                    list loc_parts = llParseString2List(llGetSubString(llGetInventoryNumber, -~llSubStringIndex(llGetInventoryNumber, " "), 99999), (list)" | " + " |" + "| " + "|", []);
                    if (!(loc_command == "TOMENU" | loc_command == "MENU"))
                        if (loc_command == "POSE")
                        {
                            if (!~llListFindList(Pop, (list)llList2String(loc_parts, 0)))
                            {
                                if (gD < ~-(loc_parts != []))
                                {
                                    gD = ~-(loc_parts != []);
                                }
                                if (1 < (loc_parts != []) + -UThreadStackFrame)
                                {
                                    loc_out = "POSE ";
                                    if (2 < (loc_parts != []) + UThreadStackFrame)
                                    {
                                        loc_out = "SYNC ";
                                    }
                                    string loc_pose = llStringTrim(llList2String(loc_parts, -~UThreadStackFrame), 3);
                                    loc_pose = llList2String(llParseString2List(loc_pose, (list)"::", []), 0);
                                    loc_pose = llList2String(llParseString2List(loc_pose, (list)";", []), 0);
                                    loc_out = loc_out + (llStringTrim(llList2String(loc_parts, 0), 3) + "|" + loc_pose);
                                    D(loc_out);
                                }
                            }
                        }
                }
                else
                {
                    if (~llSubStringIndex(llGetInventoryNumber, "{"))
                    {
                        string loc_command = llStringTrim(llGetSubString(llGetInventoryNumber, -~llSubStringIndex(llGetInventoryNumber, "{"), ~-llSubStringIndex(llGetInventoryNumber, "}")), 3);
                        if (!~llListFindList(Pop, (list)loc_command))
                        {
                            llGetInventoryNumber = (string)llParseString2List(llGetInventoryNumber, (list)" ", (list)"");
                            list loc_parts = llParseString2List(llGetInventoryNumber, (list)"<", []);
                            if (-~(UThreadStackFrame * 2) < (loc_parts != []))
                            {
                                vector loc_pos = (vector)("<" + llList2String(loc_parts, -~(UThreadStackFrame * 2)));
                                vector loc_rot = (vector)("<" + llList2String(loc_parts, -~-~(UThreadStackFrame * 2)));
                                loc_pos = loc_pos + (vector)llGetObjectDesc();
                                string loc_result = "<" + A(loc_pos.x, 3) + "," + A(loc_pos.y, 3) + "," + A(loc_pos.z, 3) + ">";
                                loc_result = loc_result + ("<" + A(loc_rot.x, 1) + "," + A(loc_rot.y, 1) + "," + A(loc_rot.z, 1) + ">");
                                D("{" + loc_command + "}" + loc_result);
                            }
                        }
                    }
                }
                gA = llGetNotecardLine(IsSaveDue, ++gC);
            }
        }
    }
}
