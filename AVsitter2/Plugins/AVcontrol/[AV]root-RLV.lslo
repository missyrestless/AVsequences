        if (llRegionSay & 32)
        {
            if (llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>)
            {
                gY = e_changed;
                e_state_entry = [];
                llSetTimerEvent(0);
                llListenRemove(IsSaveDue);
                llListenRemove(gb);
                llListenRemove(UThreadStackFrame);
                llListenRemove(System);
                H(gZ, "");
            }
            else
            {
                gb = llListen(e_dataserver, "", "", "");
                System = llListen(gB, "", "", "");
            }
            Z();
        }
        if (llRegionSay & 1)
        {
            if (!(gM == llGetInventoryKey("AVpos")))
            {
                llResetScript();
            }
        }
    }

    dataserver(key llRegionSay, string llRemoveInventory)
    {
        if (llRegionSay == e_no_sensor)
        {
            if (llRemoveInventory == "\n\n\n")
            {
                A(0, "Loaded, Memory: " + (string)llGetFreeMemory());
            }
            else
            {
                llRemoveInventory = llStringTrim(llRemoveInventory, 3);
                string loc_command = llGetSubString(llRemoveInventory, 0, ~-llSubStringIndex(llRemoveInventory, " "));
                list loc_parts = llParseStringKeepNulls(llGetSubString(llRemoveInventory, -~llSubStringIndex(llRemoveInventory, " "), 99999), (list)" | " + " |" + "| " + "|", []);
                string loc_part0 = llStringTrim(llList2String(loc_parts, 0), 3);
                loc_part0 = llGetSubString(loc_part0, 0, 22);
                if (loc_command == "WAITPOSE")
                {
                    gZ = loc_part0;
                    H(gZ, "");
                }
                else if (loc_command == "RLV")
                {
                    gI = (integer)loc_part0;
                }
                else if (loc_command == "SUBCONTROL")
                {
                    d = (integer)loc_part0;
                }
                else if (loc_command == "HTEXT")
                {
                    LslUserScript = (integer)loc_part0;
                }
                else if (loc_command == "DOMPOSE")
                {
                    gO = loc_part0;
                }
                else if (loc_command == "SUBPOSE")
                {
                    gS = loc_part0;
                }
                else if (loc_command == "ONTOUCH")
                {
                    e_chat = loc_part0;
                }
                else if (loc_command == "ONSIT")
                {
                    LslLibrary = loc_part0;
                    if (LslLibrary == "ASKONLY")
                    {
                        LslLibrary = "ASK";
                        f = 0;
                    }
                }
                else if (loc_command == "BRAND")
                {
                    gX = loc_part0;
                }
                else if (loc_command == "RECAPTURE")
                {
                    gC = (integer)loc_part0;
                }
                else if (loc_command == "ROLES")
                {
                    e_changed = loc_parts;
                    gY = e_changed;
                    llMessageLinked(((integer)-4), 90206, llDumpList2String(gY, "|"), "");
                }
                else if (loc_command == "TIMELOCK")
                {
                    gH = ga = (integer)loc_part0 * 60;
                }
                else if (loc_command == "ONCAPTURE")
                {
                    IsRestoring = llDumpList2String(loc_parts, "|");
                }
                else if (loc_command == "ONRELEASE")
                {
                    gN = llDumpList2String(loc_parts, "|");
                }
                e_no_sensor = llGetNotecardLine("AVpos", ++gT);
            }
        }
    }

