                            {
                                loc_icon = "○";
                                if (!(loc_wornThis < 2 & loc_wornSub < 2))
                                {
                                    loc_icon = "◑";
                                }
                                if (!(-!(!(loc_wornThis ^ 3 | loc_wornSub) | !(loc_wornThis | loc_wornSub ^ 3)) & (loc_wornThis ^ 3 | loc_wornSub ^ 3)))
                                {
                                    loc_icon = "●";
                                }
                                gA = gA + (loc_icon + " " + llGetSubString(loc_folder, 0, 12));
                                UThread = UThread + loc_folder;
                                loc_subInfo = "\nSubfolders:\n○ = none worn\n◑ = some worn\n● = all worn";
                            }
                        }
                        else
                        {
                            if (loc_wornThis)
                            {
                                loc_icon = "none worn";
                                if (loc_wornThis == 2)
                                {
                                    loc_icon = "some worn";
                                }
                                if (loc_wornThis == 3)
                                {
                                    loc_icon = "all worn";
                                }
                                loc_BUTTONS = loc_BUTTONS + "[➕]" + "[➖]";
                                loc_folderInfo = "\n[➕] = wear\n[➖] = remove\n";
                            }
                            llMessageLinked = "Folder: /" + llDumpList2String(Pop, "/") + "\n[" + loc_icon + "]\n" + loc_folderInfo;
                        }
                    }
                    if (gA == [] & loc_BUTTONS == [])
                    {
                        llMessageLinked = "#RLV folder empty";
                    }
                    F(llMessageLinked + loc_subInfo, loc_BUTTONS + gA);
                }
                else if (gJ == "Detach")
                {
                    E(llMessageLinked, gB);
                }
                else if (gJ == "Undress")
                {
                    E(llMessageLinked, gI);
                }
                else if (gJ == "Restrict")
                {
                    list loc_currentRestrictions = llParseString2List(llMessageLinked, (list)"/", []);
                    list loc_menu_items = (list)"[BACK]";
                    integer loc_i;
                    while (loc_i < (IsSaveDue != []))
                    {
                        list loc_subRestrictions = llParseString2List(llList2String(IsSaveDue, -~loc_i), (list)",", []);
                        integer loc_inActive;
                        integer loc_j;
                        while (loc_j < (loc_subRestrictions != []))
                        {
                            if (!~llListFindList(loc_currentRestrictions, (list)llList2String(loc_subRestrictions, loc_j)))
                            {
                                loc_inActive = 1;
                            }
                            ++loc_j;
                        }
                        string loc_symbol = "✔ ";
                        if (!loc_inActive)
                        {
                            loc_symbol = "✘ ";
                        }
                        string loc_btntext = loc_symbol + llList2String(IsSaveDue, loc_i);
                        while (llStringLength(loc_btntext) < 20)
                            loc_btntext = loc_btntext + " ";
                        loc_btntext = loc_btntext + ".";
                        loc_menu_items = loc_menu_items + loc_btntext;
                        loc_i = 3 + loc_i;
                    }
                    H("RLV for " + llKey2Name(ResumeVoid) + "\n\n✔ = Allowed\n✘ = Restricted", loc_menu_items);
                }
            }
        }
        else
        {
            if (llMessageLinked == "[>>]" | llMessageLinked == "[<<]")
            {
                if (llMessageLinked == "[<<]")
                {
                    --Library;
                }
                else
                {
                    ++Library;
                }
                G();
            }
            else if (gJ == "Browse #RLV")
            {
                integer loc_index = llListFindList(gA, (list)llMessageLinked);
                if (~loc_index)
                {
                    llMessageLinked = llList2String(UThread, loc_index);
                    Pop = Pop + llMessageLinked;
                    D(ResumeVoid, "@getinvworn:" + llDumpList2String(Pop, "/") + "=" + (string)LslUserScript);
                }
                else if (llMessageLinked == "[BACK]")
                {
                    if (Pop == [])
                    {
                        J();
                    }
                    else
                    {
                        Pop = llDeleteSubList(Pop, ((integer)-1), ((integer)-1));
                        D(ResumeVoid, "@getinvworn:" + llDumpList2String(Pop, "/") + "=" + (string)LslUserScript);
                    }
                }
                else if (llMessageLinked == "[➕]" | llMessageLinked == "[➖]")
                {
                    loc_command = "attach";
                    if (llMessageLinked == "[➖]")
                    {
                        loc_command = "detach";
                    }
                    D(ResumeVoid, "@" + loc_command + ":" + llDumpList2String(Pop, "/") + "=force");
                    llSleep(4);
                    D(ResumeVoid, "@getinvworn:" + llDumpList2String(Pop, "/") + "=" + (string)LslUserScript);
                }
            }
            else if (llMessageLinked == "[BACK]")
            {
                if (gJ == "Restrict" | gJ == "")
                {
                    llMessageLinked(((integer)-4), 90100, "0|Control...|" + (string)ResumeVoid, UThreadStackFrame);
                }
                else
                {
                    J();
                }
            }
            else if (gJ == "Detach" | gJ == "Undress")
            {
                integer loc_index = llListFindList(gI, (list)llMessageLinked);
                loc_command = "outfit";
                if (!~loc_index)
                {
                    loc_index = llListFindList(gB, (list)llMessageLinked);
                    loc_command = "attach";
                }
                if (~loc_index)
                {
                    D(ResumeVoid, "@rem" + loc_command + ":" + llMessageLinked + "=force");
                    llSleep(2);
                    D(ResumeVoid, "@get" + loc_command + "=" + (string)LslUserScript);
                }
            }
            else if (llMessageLinked == "Detach" | llMessageLinked == "Undress" | llMessageLinked == "Browse #RLV")
            {
                gJ = llMessageLinked;
                Pop = [];
                loc_command = "getoutfit";
                if (llMessageLinked == "Detach")
                    loc_command = "getattach";
                if (llMessageLinked == "Browse #RLV")
                    loc_command = "getinvworn";
                D(ResumeVoid, "@" + loc_command + "=" + (string)LslUserScript);
            }
            else if (llMessageLinked == "Fast Strip")
            {
                gJ = "fs";
                H("Are you really sure? This will try to remove almost everything the avatar is wearing.", (list)"[BACK]" + "YES!");
            }
            else if (llMessageLinked == "YES!")
            {
                integer loc_i;
                for (loc_i = 0; loc_i < (gI != []); ++loc_i)
                {
                    if (!(llList2String(gI, loc_i) == ""))
                    {
                        D(ResumeVoid, "@remoutfit:" + llList2String(gI, loc_i) + "=force");
                    }
                }
                for (loc_i = 0; loc_i < (gB != []); ++loc_i)
                {
                    if (!(llList2String(gB, loc_i) == ""))
                    {
                        if (loc_i ^ 2)
                        {
                            D(ResumeVoid, "@remattach:" + llList2String(gB, loc_i) + "=force");
                        }
                    }
                }
                J();
            }
            else
            {
                integer loc_index = llListFindList(llList2ListStrided(IsSaveDue, 0, ((integer)-1), 3), (list)llList2String(llParseString2List(llMessageLinked, (list)" ", []), 1));
                if (~loc_index)
                {
                    list loc_subRestrictions = llParseString2List(llList2String(IsSaveDue, -~(loc_index * 3)), (list)",", []);
                    string loc_param = "n";
                    string loc_chatText = B(llKey2Name(ResumeVoid), " Resident", "") + " is ";
                    if (~llSubStringIndex(llMessageLinked, "✘ "))
                    {
                        loc_param = "y";
                        loc_chatText = loc_chatText + "no longer ";
                    }
                    integer loc_i;
                    while (loc_i < (loc_subRestrictions != []))
                    {
                        D(ResumeVoid, "@" + llList2String(loc_subRestrictions, loc_i) + "=" + loc_param);
                        ++loc_i;
                    }
                    llSay(0, loc_chatText + "restricted from " + llList2String(IsSaveDue, -~-~(loc_index * 3)) + ".");
                    D(ResumeVoid, "@getstatus=" + (string)LslUserScript);
                }
            }
        }
    }
}
