//nfo_preprocessor_version 0
//program_version LSL PyOptimizer v0.3.0beta
//mono

key g_;
key edefaultchanged;
integer System;
list UThreadStackFrame;
list gA;
list Library;
integer LslUserScript = 30;
string Pop;
list IsRestoring;
list LslLibrary = [Pop];
integer IsSaveDue;

_(integer llGetNumberOfPrims, string llKey2Name)
{
    if (llGetNumberOfPrims < 1)
    {
        llOwnerSay(llGetScriptName() + "[1.02]:" + llKey2Name);
    }
}

string A(string llGetNumberOfPrims)
{
    integer loc_i;
    for (loc_i = 0; loc_i < (LslLibrary != []); ++loc_i)
    {
        string loc_sitter_name = llList2String(llParseString2List(llKey2Name(llList2String(LslLibrary, loc_i)), (list)" ", []), 0);
        if (loc_sitter_name == "")
        {
            loc_sitter_name = "(nobody)";
        }
        llGetNumberOfPrims = B(llGetNumberOfPrims, "/" + (string)loc_i, loc_sitter_name);
    }
    return llGetNumberOfPrims;
}

string B(string llGetNumberOfPrims, string llKey2Name, string llGetLinkKey)
{
    return llDumpList2String(llParseStringKeepNulls(llGetNumberOfPrims, (list)llKey2Name, []), llGetLinkKey);
}

default
{
    state_entry()
    {
        g_ = llGetInventoryKey("[AV]Xcite_settings");
        _(0, "Loading...");
        edefaultchanged = llGetNotecardLine("[AV]Xcite_settings", 0);
    }

    changed(integer llGetNumberOfPrims)
    {
        if (llGetNumberOfPrims & 1)
        {
            if (!(llGetInventoryKey("[AV]Xcite_settings") == g_))
            {
                llResetScript();
            }
        }
        if (llGetNumberOfPrims & 32)
        {
            if (llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>)
            {
                IsRestoring = [];
            }
        }
    }

    link_message(integer llGetNumberOfPrims, integer llKey2Name, string llGetLinkKey, key llGetAgentSize)
    {
        if (llGetNumberOfPrims == llGetLinkNumber())
        {
            if (llKey2Name == 90045)
            {
                string loc_name = llKey2Name(llGetAgentSize);
                if (!(loc_name == ""))
                {
                    integer loc_i = IsRestoring != [];
                    while (0 < loc_i)
                    {
                        --loc_i;
                        if (!llSubStringIndex(llList2String(IsRestoring, loc_i), loc_name + "|"))
                        {
                            IsRestoring = llDeleteSubList(IsRestoring, loc_i, loc_i);
                        }
                    }
                    llSetTimerEvent(LslUserScript);
                    list loc_data = llParseStringKeepNulls(llGetLinkKey, (list)"|", []);
                    integer loc_script_channel = (integer)llList2String(loc_data, 0);
                    Pop = llList2String(loc_data, 1);
                    LslLibrary = llParseStringKeepNulls(llList2String(loc_data, 4), (list)"@", []);
                    integer loc_index = llListFindList(UThreadStackFrame, (list)(Pop + "|" + (string)loc_script_channel));
                    if (!~loc_index)
                    {
                        loc_index = llListFindList(UThreadStackFrame, (list)(Pop + "|*"));
                        if (!~loc_index)
                        {
                            loc_index = llListFindList(UThreadStackFrame, (list)"*|*");
                            if (!~loc_index)
                            {
                                return;
                            }
                        }
                    }
                    if (llList2Integer(Library, loc_index))
                    {
                        if (IsSaveDue)
                        {
                            _(0, "Setting " + loc_name + "'s tilt to " + llList2String(Library, loc_index));
                        }
                        llMessageLinked(((integer)-1), 20020, loc_name + "|" + llList2String(Library, loc_index), "");
                    }
                    else
                    {
                        if (IsSaveDue)
                        {
                            _(0, "Restoring " + loc_name + "'s tilt.");
                        }
                        llMessageLinked(((integer)-1), 20014, loc_name, "");
                    }
                    loc_data = llParseStringKeepNulls(llList2String(gA, loc_index), (list)"|", []);
                    IsRestoring = IsRestoring + (loc_name + "|" + llList2String(loc_data, 0) + "|" + llList2String(loc_data, 1) + "||" + llList2String(loc_data, 3));
                    string loc_commands = A(llList2String(gA, loc_index));
                    llMessageLinked(((integer)-1), 20001, loc_name + "|" + loc_commands, "00000000-0000-0000-0000-000000000000");
                    if (IsSaveDue)
                    {
                        _(0, "Sending xcite commands: " + loc_name + "|" + loc_commands);
                    }
                }
            }
        }
    }

    timer()
    {
        integer loc_i;
        for (; loc_i < (IsRestoring != []); ++loc_i)
        {
            llMessageLinked(((integer)-1), 20001, llList2String(IsRestoring, loc_i), "00000000-0000-0000-0000-000000000000");
            if (IsSaveDue)
            {
                _(0, "Sending xcite commands: " + llList2String(IsRestoring, loc_i));
            }
        }
    }

    dataserver(key llGetNumberOfPrims, string llKey2Name)
    {
        if (llGetNumberOfPrims == edefaultchanged)
        {
            if (llKey2Name == "\n\n\n" | llStringTrim(llToLower(llKey2Name), 3) == "end")
            {
                _(0, (string)(UThreadStackFrame != []) + " items Ready, Mem=" + (string)llGetFreeMemory());
            }
            else
            {
                llKey2Name = llStringTrim(llKey2Name, 3);
                string loc_command = llGetSubString(llKey2Name, 0, ~-llSubStringIndex(llKey2Name, " "));
                list loc_parts = llParseStringKeepNulls(llGetSubString(llKey2Name, -~llSubStringIndex(llKey2Name, " "), 99999), (list)" | " + " |" + "| " + "|", []);
                if (loc_command == "TIMER")
                {
                    LslUserScript = llList2Integer(loc_parts, 0);
                }
                if (loc_command == "DEBUG")
                {
                    IsSaveDue = llList2Integer(loc_parts, 0);
                }
                if (loc_command == "XCITE")
                {
                    UThreadStackFrame = UThreadStackFrame + (llStringTrim(llList2String(loc_parts, 0), 3) + "|" + llList2String(loc_parts, 1));
                    gA = gA + (llList2String(loc_parts, 2) + "|" + llList2String(loc_parts, 3) + "|" + llList2String(loc_parts, 4) + "|" + llList2String(loc_parts, 5));
                    Library = Library + llList2Integer(loc_parts, 6);
                }
                edefaultchanged = llGetNotecardLine("[AV]Xcite_settings", ++System);
            }
        }
    }
}
