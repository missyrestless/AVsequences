list edefaultchanged;
key IsSaveDue = "00000000-0000-0000-0000-000000000000";
string LslLibrary;
list g_ = [LslLibrary];
list System;
integer edefaultrez;
integer edefaultstate_entry;

list _(list llParseStringKeepNulls)
{
    return llList2List(llParseStringKeepNulls, ((integer)-3), ((integer)-1)) + llList2List(llParseStringKeepNulls, ((integer)-6), ((integer)-4)) + llList2List(llParseStringKeepNulls, ((integer)-9), ((integer)-7)) + llList2List(llParseStringKeepNulls, ((integer)-12), ((integer)-10));
}

string A(string llParseStringKeepNulls, string llListen, string llGetSubString)
{
    return llDumpList2String(llParseStringKeepNulls(llParseStringKeepNulls, (list)llListen, []), llGetSubString);
}

B(key llParseStringKeepNulls)
{
    IsSaveDue = llParseStringKeepNulls;
    LslLibrary = llKey2Name(llParseStringKeepNulls);
    list loc_SITTERS;
    integer loc_count = llGetNumberOfPrims();
    while (!(llGetAgentSize(llGetLinkKey(loc_count)) == <((float)0), ((float)0), ((float)0)>))
    {
        loc_SITTERS = loc_SITTERS + llGetLinkKey(loc_count);
        --loc_count;
    }
    if (!~llListFindList(loc_SITTERS, (list)llParseStringKeepNulls) | !D())
    {
        if (~-(loc_SITTERS != []) | -!(!D() | !~llListFindList(edefaultchanged, (list)"S")) & ~-(edefaultchanged != []))
        {
            list loc_menu_items;
            g_ = [];
            integer loc_i;
            for (loc_i = 0; loc_i < (loc_SITTERS != []); ++loc_i)
            {
                if (!(llList2Key(loc_SITTERS, loc_i) == "00000000-0000-0000-0000-000000000000"))
                {
                    loc_menu_items = loc_menu_items + llGetSubString(A(llKey2Name(llList2Key(loc_SITTERS, loc_i)), " Resident", ""), 0, 11);
                    g_ = g_ + llList2Key(loc_SITTERS, loc_i);
                }
            }
            System = loc_menu_items;
            string loc_text = "Which avatar?";
            if (D())
            {
                if (loc_menu_items == [])
                {
                    llMessageLinked(((integer)-4), 90211, "", llParseStringKeepNulls);
                    return;
                }
                if (~llListFindList(edefaultchanged, (list)"S") & -((loc_SITTERS != []) < (edefaultchanged != [])))
                {
                    loc_text = loc_text + "\n\nCapture = trap a new avatar.";
                    loc_menu_items = loc_menu_items + "Capture...";
                }
            }
            if (loc_menu_items != [])
            {
                C(loc_text, _(loc_menu_items), llParseStringKeepNulls);
            }
        }
        else
        {
            if (D())
            {
                llMessageLinked(((integer)-4), 90100, "x|Control...|" + llList2String(loc_SITTERS, 0), llParseStringKeepNulls);
            }
            else
            {
                llMessageLinked(((integer)-1), 90005, "", (string)llParseStringKeepNulls + ("|" + (string)llList2Key(loc_SITTERS, 0)));
            }
        }
    }
    else
    {
        llMessageLinked(((integer)-1), 90005, "", llParseStringKeepNulls);
    }
}

C(string llParseStringKeepNulls, list llListen, key llGetSubString)
{
    llListenRemove(edefaultstate_entry);
    edefaultstate_entry = llListen(edefaultrez = ~(integer)llFrand(2147483520), "", llGetSubString, "");
    llDialog(llGetSubString, "AVsitter™ Menu Control 2.2p04\n\n" + llParseStringKeepNulls + "\n", _(llListen), edefaultrez);
    llSetTimerEvent(120);
}

integer D()
{
    if (llGetInventoryType("[AV]root-RLV") == 10)
    {
        return 1;
    }
    return 0;
}

default
{
    state_entry()
    {
        llSetTimerEvent(0);
    }

    on_rez(integer llParseStringKeepNulls)
    {
        llResetScript();
    }

    timer()
    {
        llListenRemove(edefaultstate_entry);
    }

    link_message(integer llParseStringKeepNulls, integer llListen, string llGetSubString, key llFrand)
    {
        if (llListen ^ 90007)
        {
            if (llListen == 90206)
            {
                edefaultchanged = llParseStringKeepNulls(llGetSubString, (list)"|", []);
            }
        }
        else
        {
            if (llFrand == IsSaveDue | IsSaveDue == "00000000-0000-0000-0000-000000000000")
            {
                B(llFrand);
            }
            else
            {
                string loc_text = "Take control of the menu?";
                if (!(llGetAgentSize(IsSaveDue) == <((float)0), ((float)0), ((float)0)>))
                {
                    loc_text = loc_text + ("\n\nCurrently controlled by: " + LslLibrary);
                }
                C(loc_text, (list)"Take Control" + "[CANCEL]", llFrand);
            }
        }
    }

    listen(integer llParseStringKeepNulls, string llListen, key llGetSubString, string llFrand)
    {
        llListenRemove(edefaultstate_entry);
        integer loc_index = llListFindList(System, (list)llFrand);
        if (~loc_index)
        {
            if (D())
            {
                llMessageLinked(((integer)-4), 90100, "x|Control...|" + llList2String(g_, loc_index), IsSaveDue);
            }
            else
            {
                llMessageLinked(((integer)-1), 90005, "", (string)IsSaveDue + ("|" + (string)llList2Key(g_, loc_index)));
            }
        }
        else if (llFrand == "Capture...")
        {
            llMessageLinked(((integer)-4), 90211, "", llGetSubString);
        }
        else if (llFrand == "Take Control")
        {
            llMessageLinked(((integer)-1), 90033, "", "");
            if (!(llGetSubString == IsSaveDue))
            {
                llRegionSayTo(IsSaveDue, 0, llKey2Name(llGetSubString) + " has taken control of the menu.");
            }
            B(llGetSubString);
        }
    }

    changed(integer llParseStringKeepNulls)
    {
        if (llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>)
        {
            IsSaveDue = "00000000-0000-0000-0000-000000000000";
        }
    }
}
