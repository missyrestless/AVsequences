                        }
                    else
                    {
                        gK = llListReplaceList(gK, (list)llGetLinkNumber, (integer)e_link_message, (integer)e_link_message);
                    }
                else
                {
                    gK = llListReplaceList(gK, (list)"00000000-0000-0000-0000-000000000000", (integer)e_link_message, (integer)e_link_message);
                    gK = llListReplaceList(gK, (list)"00000000-0000-0000-0000-000000000000", (integer)((string)llGetLinkNumber), (integer)((string)llGetLinkNumber));
                    H(1);
                }
            else
            {
                integer loc_index = llListFindList(gK, (list)llGetLinkNumber);
                if (~loc_index)
                {
                    gK = llListReplaceList(gK, (list)"00000000-0000-0000-0000-000000000000", loc_index, loc_index);
                }
                H(1);
            }
        }
    }

    listen(integer llStringTrim, string llListenRemove, key e_link_message, string llGetLinkNumber)
    {
        if (llGetLinkNumber == "▮▮")
        {
            gE = 0;
            llSetTimerEvent(0);
            C(1, "Sequence '" + e_timer + "' Paused!");
        }
        else if (llGetLinkNumber == "▶")
        {
            gE = 1;
            ++edefaultdataserver;
            C(1, "Sequence '" + e_timer + "' Resumed!");
            D();
        }
        else if (llGetLinkNumber == "▶▶")
        {
            ++edefaultdataserver;
            D();
        }
        else if (llGetLinkNumber == "◀◀")
        {
            integer loc_count_waits;
            while (((integer)-1) < edefaultdataserver & loc_count_waits < 2)
            {
                --edefaultdataserver;
                if (llList2String(IsSaveDue, edefaultdataserver) == "WAIT")
                {
                    ++loc_count_waits;
                }
            }
            ++edefaultdataserver;
            D();
        }
        else if (llGetLinkNumber == "[BACK]")
        {
            llMessageLinked(((integer)-1), 90005, "", (string)e_link_message + "|" + (string)Pop);
            return;
        }
        I();
    }

    timer()
    {
        llSetTimerEvent(0);
        ++edefaultdataserver;
        D();
    }

    on_rez(integer llStringTrim)
    {
        gA = 1;
    }

    changed(integer llStringTrim)
    {
        if (llStringTrim & 1)
        {
            if (!(llGetInventoryKey("[AV]sequence_settings") == gH & E() == (gK != [])))
            {
                llResetScript();
            }
        }
    }
}
