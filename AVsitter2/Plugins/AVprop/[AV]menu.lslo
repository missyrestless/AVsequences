            llDialog(llMessageLinked, "AVmenu™ 2.2p04\n\n" + llList2String(llParseString2List(edefaulttouch_start, (list)" ", []), 0) + " is already using the menu.\nPlease wait a moment.", [], ((integer)-585868));
        }
    }
}

I()
{
    string loc_text;
    list loc_menu_items = (list)"[BACK]";
    loc_text = "Prop options:\n";
    if (!(!F(1) | !G()))
    {
        loc_menu_items = loc_menu_items + "[NEW]" + "[DUMP]";
