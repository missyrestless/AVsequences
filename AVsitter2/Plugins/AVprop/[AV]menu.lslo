        llDialog(llMessageLinked, "AVmenu™ 2.2p04\n\nSorry, the owner has set this menu to: " + llList2String(gJ, edefaultlink_message), [], ((integer)-585868));
    }
    else
    {
        if (llInstantMessage == edefaulttouch_start | 5 < llGetUnixTime() + -gB)
