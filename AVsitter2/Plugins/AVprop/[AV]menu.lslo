integer _(key llInstantMessage)
{
    integer loc_access_allowed;
    string loc_SECURITY_TYPE = llList2String(gJ, edefaultlink_message);
    if (loc_SECURITY_TYPE == "ALL")
    {
        loc_access_allowed = 1;
    }
    else if (!(loc_SECURITY_TYPE == "GROUP ONLY") | ~-llSameGroup(llInstantMessage))
    {
        if (llInstantMessage == llGetOwner())
        {
            loc_access_allowed = 1;
        }
    }
    else
    {
        loc_access_allowed = 1;
    }
    return loc_access_allowed;
}

A()
{
    if (llGetInventoryType("[AV]sitA") == 10)
    {
        L("This script can not be used with the sit script in the same prim. Removing script!");
    }
}

list B(list llInstantMessage)
