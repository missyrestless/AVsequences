    loc_text = loc_text + "\n[SECURITY] = Menu security.";
    loc_text = loc_text + "\n[RESET] = Reload notecard.";
    E(llGetOwner(), loc_text, loc_menu_items);
}

J(list llInstantMessage, string llMessageLinked)
{
    gL = llMessageLinked;
    IsSaveDue = 1;
    llMessageLinked = "\n(Page " + (string)(-~Pop) + "/" + (string)LslUserScript + ")\n" + llMessageLinked + "\n\n";
    list loc_menu_items;
    integer loc_i;
    if (llInstantMessage == [])
    {
        llMessageLinked = "\nNo items of required type in the prim inventory.";
        loc_menu_items = (list)"[BACK]";
    }
    else
    {
        integer loc_cutoff = 65;
        integer loc_all_options_length = llStringLength((string)llInstantMessage);
        integer loc_total_need_to_cut = 412 + -loc_all_options_length;
        if (loc_total_need_to_cut < 0)
        {
            loc_cutoff = 43;
        }
        for (loc_i = 0; loc_i < (llInstantMessage != []); ++loc_i)
        {
            loc_menu_items = loc_menu_items + (string)(-~loc_i);
            string loc_item = llList2String(llInstantMessage, loc_i);
            if (loc_cutoff < llStringLength(loc_item))
            {
                loc_item = llGetSubString(loc_item, 0, loc_cutoff) + "..";
            }
            llMessageLinked = llMessageLinked + ((string)(-~loc_i) + "." + loc_item + "\n");
        }
        while ((loc_menu_items != []) < 9)
        {
            loc_menu_items = loc_menu_items + " ";
        }
        loc_menu_items = loc_menu_items + "[BACK]" + "[<<]" + "[>>]";
    }
    E(llGetOwner(), llMessageLinked, loc_menu_items);
}

list K(integer llInstantMessage)
{
    Pop = llInstantMessage;
    list loc_options;
    integer loc_i;
    integer loc_start = 9 * Pop;
    integer loc_end = 9 + loc_start;
    loc_i = loc_start;
    while ((loc_options != []) + loc_start < loc_end & loc_i < llGetInventoryNumber(6))
    {
        loc_options = loc_options + llGetInventoryName(6, loc_i);
        ++loc_i;
    }
    loc_i = llGetInventoryNumber(6);
    LslUserScript = llCeil((float)loc_i / 9);
    return loc_options;
}

L(string llInstantMessage)
{
    string loc_message = "\n" + llGetScriptName() + " ==Script Removed==\n\n" + llInstantMessage;
    llDialog(llGetOwner(), loc_message, [], ((integer)-3675));
    llInstantMessage(llGetOwner(), loc_message);
    llRemoveInventory(llGetScriptName());
}

integer M(integer llInstantMessage, key llMessageLinked)
{
    IsSaveDue = 0;
    gI = "";
    integer loc_total_items;
    integer loc_i = -~gK;
    while (-(loc_i < (gM != [])) & llSubStringIndex(llList2String(gM, loc_i), "M:"))
    {
        ++loc_total_items;
        ++loc_i;
    }
    list loc_menu_items2;
    if (~gK)
    {
        loc_menu_items2 = "[BACK]" + loc_menu_items2;
    }
    list loc_menu_items1;
    if (llGetInventoryType("[AV]prop") == 10)
    {
        loc_menu_items2 = loc_menu_items2 + "[OWNER]";
    }
    if (12 < loc_total_items + (loc_menu_items2 != []))
    {
        loc_menu_items2 = loc_menu_items2 + "[<<]" + "[>>]";
    }
    integer loc_items_per_page = 12 + -(loc_menu_items2 != []);
    integer loc_page_start = -~gK + Pop * loc_items_per_page;
    for (loc_i = loc_page_start; loc_i < loc_page_start + loc_items_per_page; ++loc_i)
    {
        if (loc_i < (gM != []))
        {
            if (!llSubStringIndex(llList2String(gM, loc_i), "M:"))
            {
                jump J_autoGen00001;
            }
            if (~llListFindList((list)"T:" + "S:" + "B:", (list)llGetSubString(llList2String(gM, loc_i), 0, 1)))
            {
                loc_menu_items1 = loc_menu_items1 + llGetSubString(llList2String(llParseString2List(llList2String(gM, loc_i), (list)"|", []), 0), 2, 99999);
            }
            else
            {
                loc_menu_items1 = loc_menu_items1 + llList2String(gM, loc_i);
            }
        }
    }
    @J_autoGen00001;
    if (llInstantMessage)
    {
        integer loc_pages = llCeil(loc_total_items) / (12 + -(loc_menu_items2 != []));
        if (!(loc_total_items % (12 + -(loc_menu_items2 != []))))
        {
            --loc_pages;
        }
        return loc_pages;
    }
    if (llList2String(loc_menu_items2, 0) == "[BACK]")
    {
        loc_menu_items1 = "[BACK]" + loc_menu_items1;
        loc_menu_items2 = llDeleteSubList(loc_menu_items2, 0, 0);
    }
    gD = ~(integer)llFrand(2147483520);
    llListenRemove(UThreadStackFrame);
    UThreadStackFrame = llListen(gD, "", llMessageLinked, "");
    E(llMessageLinked, g_, loc_menu_items1 + loc_menu_items2);
    return 0;
}

string N(string llInstantMessage, string llMessageLinked, string llList2List)
{
    return llDumpList2String(llParseStringKeepNulls(llInstantMessage, (list)llMessageLinked, []), llList2List);
}

O()
{
    llTextBox(llGetOwner(), "\nPlease type a button name for your prop\nProp: " + gI, gD);
}

default
{
    state_entry()
    {
        if (~llSubStringIndex(llGetScriptName(), " "))
        {
            L("Use only one copy of this script!");
        }
        gM = [];
        A();
        gA = llGetInventoryKey("AVpos");
        C(0, "Loading...");
        gO = llGetNotecardLine("AVpos", System);
    }

    timer()
    {
        llListenRemove(UThreadStackFrame);
    }

    listen(integer llInstantMessage, string llMessageLinked, key llList2List, string llSleep)
    {
        if (!(gI == ""))
        {
            if (llSleep == "")
            {
                O();
            }
            else
            {
                integer loc_perms = llGetInventoryPermMask(gI, 4);
                if (loc_perms & 32768)
                {
                    llMessageLinked(((integer)-4), 90173, llSleep, gI);
                    gM = "B:" + llSleep + gM;
                    edefaultchat = 90200 + edefaultchat;
                }
                else
                {
                    llSay(0, "Could not add prop '" + gI + "'. Props and their content must be COPY-OK for NEXT owner.");
                }
                gI = "";
                I();
            }
            return;
        }
        if (!(!IsSaveDue | !~llListFindList((list)"1" + "2" + "3" + "4" + "5" + "6" + "7" + "8" + "9", (list)llSleep)))
        {
            IsSaveDue = 0;
            gI = llList2String(K(Pop), ~-(integer)llSleep);
            O();
            return;
        }
        if (llSleep == "[SECURITY]")
        {
            if (llList2List == llGetOwner())
            {
                E(llGetOwner(), "Who is allowed to control this menu?", gJ);
            }
            else
            {
                llRegionSayTo(llList2List, 0, "Sorry, only the owner can use this.");
            }
            return;
        }
        integer loc_mindex_test = llListFindList(gM, (list)("M:" + llSleep));
        if (~loc_mindex_test)
        {
            Pop = 0;
            gK = loc_mindex_test;
        }
        loc_mindex_test = llListFindList(gM, (list)("B:" + llSleep));
        if (~loc_mindex_test)
        {
            list loc_button_data = llParseStringKeepNulls(llList2String(edefaultchat, loc_mindex_test), (list)"�", []);
            if (!(llList2String(loc_button_data, 1) == ""))
            {
                llSleep = llList2String(loc_button_data, 1);
            }
            if (!(llList2String(loc_button_data, 2) == ""))
            {
                llList2List = llList2String(loc_button_data, 2);
            }
            llMessageLinked(((integer)-1), (integer)llList2String(loc_button_data, 0), llSleep, llList2List);
            return;
        }
        else if (llSleep == "[>>]" | llSleep == "[<<]")
        {
            if (IsSaveDue)
            {
                if (llSleep == "[>>]")
                {
                    ++Pop;
                    if (!(Pop < LslUserScript))
                    {
                        Pop = 0;
                    }
                }
                else if (llSleep == "[<<]")
                {
                    --Pop;
                    if (Pop < 0)
                    {
                        Pop = ~-LslUserScript;
                    }
                }
                J(K(Pop), gL);
            }
            else
            {
                if (llSleep == "[<<]")
                {
                    --Pop;
                    if (Pop < 0)
                    {
                        Pop = M(1, "00000000-0000-0000-0000-000000000000");
                    }
                }
                else
                {
                    ++Pop;
                    if (Pop > M(1, "00000000-0000-0000-0000-000000000000"))
                    {
                        Pop = 0;
                    }
                }
                M(0, llList2List);
            }
            return;
        }
        else if (llSleep == "[BACK]")
        {
            Pop = 0;
            gK = ((integer)-1);
        }
        else if (llSleep == "[NEW]")
        {
            llMessageLinked(((integer)-4), 90200, "", "");
            J(K(0), "Please choose your prop:\n\n(Props must include the [AV]object script!)");
            return;
        }
        else if (llSleep == "[DUMP]")
        {
            D("");
            D("--✄--COPY BELOW INTO \"AVpos\" NOTECARD--✄--");
            D("");
            if (!(g_ == ""))
            {
                D("TEXT " + N(g_, "\n", "\\n"));
            }
            integer loc_i;
            for (loc_i = 0; loc_i < (gM != []); ++loc_i)
            {
                list loc_change_me = llParseString2List(llList2String(gM, loc_i), (list)":", []);
                if (loc_change_me != [] == 2)
                {
                    if (llList2String(loc_change_me, 0) == "M")
                    {
                        D("MENU " + llGetSubString(llList2String(loc_change_me, 1), 0, ((integer)-2)));
                    }
                    else if (llList2String(loc_change_me, 0) == "T")
                    {
                        D("TOMENU " + llGetSubString(llList2String(loc_change_me, 1), 0, ((integer)-2)));
                    }
                    else if (llList2String(loc_change_me, 0) == "B")
                    {
                        list loc_l = [llList2String(loc_change_me, 1), N(N(llList2String(edefaultchat, loc_i), "90200", ""), "�", "|")];
                        if (llList2String(loc_l, 1) == "")
                        {
                            loc_l = llList2List(loc_l, 0, 0);
                        }
                        string loc_end = llDumpList2String(loc_l, "|");
                        D("BUTTON " + loc_end);
                    }
                }
            }
            llMessageLinked(((integer)-4), 90020, "0", "[AV]prop");
            return;
        }
        else if (llSleep == "[SAVE]" & llList2List == llGetOwner())
        {
            llMessageLinked(((integer)-1), 90101, "0|" + llSleep, "");
            I();
            return;
        }
        else if (llSleep == "[CLEAR]")
        {
            C(0, "Props have been cleared!");
            llMessageLinked(((integer)-4), 90200, "", "");
        }
        else if (llSleep == "[RESET]")
        {
            llMessageLinked(((integer)-4), 90200, "", "");
            llSleep(1);
            llResetOtherScript("[AV]prop");
            llResetScript();
            return;
        }
        else if (!(llSleep == "[BACK]"))
            if (llSleep == "[OWNER]")
            {
                if (llList2List == llGetOwner())
                {
                    I();
                    return;
                }
                else
                {
                    llRegionSayTo(llList2List, 0, "Sorry, only the owner can use this.");
                }
            }
            else if (-(llList2List == llGetOwner()) & ~llListFindList(gJ, (list)llSleep))
            {
                edefaultlink_message = llListFindList(gJ, (list)llSleep);
                C(0, "Menu access set to: " + llList2String(gJ, edefaultlink_message));
                if (llGetInventoryType("[AV]prop") == 10)
                {
                    I();
                    return;
                }
            }
        M(0, llList2List);
    }

    touch_start(integer llInstantMessage)
    {
        if (IsRestoring < 3)
        {
            H(llDetectedName(0), llDetectedKey(0));
        }
    }

    changed(integer llInstantMessage)
    {
        if (llInstantMessage & 1)
        {
            if (!(llGetInventoryKey("AVpos") == gA))
            {
                llResetScript();
            }
            A();
        }
    }

    link_message(integer llInstantMessage, integer llMessageLinked, string llList2List, key llSleep)
    {
        if (!(-!(llInstantMessage == llGetLinkNumber()) & ~-gN))
        {
            if (llMessageLinked ^ 90005)
                if (llMessageLinked ^ 90022)
                {
                    if (llMessageLinked == 90021)
                    {
                        D("");
                        D("--✄--COPY ABOVE INTO \"AVpos\" NOTECARD--✄--");
                        D("");
                    }
                }
                else
                {
                    D(llList2List);
                }
            else
            {
                H(llKey2Name(llSleep), llSleep);
            }
        }
    }

    dataserver(key llInstantMessage, string llMessageLinked)
    {
        if (llInstantMessage == gO)
        {
            if (llMessageLinked == "\n\n\n")
            {
                C(0, (string)(gM != []) + " menu items Ready, Memory: " + (string)llGetFreeMemory());
                llPassTouches(0);
                if (IsRestoring == 3)
                {
                    llPassTouches(1);
                }
            }
            else
            {
                llMessageLinked = llGetSubString(llMessageLinked, -~llSubStringIndex(llMessageLinked, "◆"), 99999);
                llMessageLinked = llStringTrim(llMessageLinked, 3);
                string loc_command = llGetSubString(llMessageLinked, 0, ~-llSubStringIndex(llMessageLinked, " "));
                list loc_parts = llParseStringKeepNulls(llGetSubString(llMessageLinked, -~llSubStringIndex(llMessageLinked, " "), 99999), (list)" | " + " |" + "| " + "|", []);
                string loc_part0 = llStringTrim(llList2String(loc_parts, 0), 3);
                string loc_part1 = llList2String(loc_parts, 1);
                if (1 < (loc_parts != []))
                {
                    loc_part1 = llStringTrim(llDumpList2String(llList2List(loc_parts, 1, 99999), "�"), 3);
                }
                if (loc_command == "TEXT")
                {
                    g_ = N(loc_part0, "\\n", "\n");
                }
                loc_part0 = llGetSubString(loc_part0, 0, 22);
                if (loc_command == "MENU")
                {
                    gM = gM + ("M:" + loc_part0 + "*");
                    edefaultchat = edefaultchat + "";
                }
                else if (loc_command == "TOMENU")
                {
                    gM = gM + ("T:" + loc_part0 + "*");
                    edefaultchat = edefaultchat + "";
                }
                else if (loc_command == "BUTTON")
                {
                    gM = gM + ("B:" + loc_part0);
                    if (loc_part1 == "")
                    {
                        loc_part1 = "90200";
                    }
                    edefaultchat = edefaultchat + loc_part1;
                }
                else if (loc_command == "MTYPE")
                {
                    IsRestoring = (integer)loc_part0;
                }
                else if (loc_command == "LMSOURCE")
                {
                    gN = (integer)loc_part0;
                }
                gO = llGetNotecardLine("AVpos", ++System);
            }
        }
    }
}
