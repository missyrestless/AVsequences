    return llList2List(llInstantMessage, ((integer)-3), ((integer)-1)) + llList2List(llInstantMessage, ((integer)-6), ((integer)-4)) + llList2List(llInstantMessage, ((integer)-9), ((integer)-7)) + llList2List(llInstantMessage, ((integer)-12), ((integer)-10));
