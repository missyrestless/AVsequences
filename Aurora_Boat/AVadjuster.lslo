string _(float llGetPos, integer llGetNumberOfPrims)
{
    llGetPos = llGetPos + ((0 < llGetPos) + -(llGetPos < 0)) * (((float)-5e-07) + (float)(".5e-" + (string)llGetNumberOfPrims));
    string loc_ret = llGetSubString((string)llGetPos, 0, ((integer)-7) + (llGetNumberOfPrims + -!llGetNumberOfPrims));
    if (llGetNumberOfPrims)
    {
        llGetNumberOfPrims = ((integer)-1);
        while (llGetSubString(loc_ret, llGetNumberOfPrims, llGetNumberOfPrims) == "0")
        {
            --llGetNumberOfPrims;
        }
        if (llGetSubString(loc_ret, llGetNumberOfPrims, llGetNumberOfPrims) == ".")
        {
            --llGetNumberOfPrims;
        }
        return llGetSubString(loc_ret, 0, llGetNumberOfPrims);
    }
    return loc_ret;
}

A(integer llGetPos)
