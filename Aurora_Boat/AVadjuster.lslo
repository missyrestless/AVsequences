list F()
{
    integer loc_my_number_per_page = 9;
    if (ResumeVoid == "[SYNC]" & 1 < gR)
    {
        --loc_my_number_per_page;
    }
    list loc_options;
    integer loc_i;
    integer loc_start = loc_my_number_per_page * gE;
    integer loc_end = loc_start + loc_my_number_per_page;
    if (ResumeVoid == "[FACE]")
    {
        list loc_facial_anim_list = (list)"none" + "express_afraid_emote" + "express_anger_emote" + "express_laugh_emote" + "express_bored_emote" + "express_cry_emote" + "express_embarrassed_emote" + "express_sad_emote" + "express_toothsmile" + "express_smile" + "express_surprise_emote" + "express_worry_emote" + "express_repulsed_emote" + "express_shrug_emote" + "express_wink_emote" + "express_disdain" + "express_frown" + "express_kiss" + "express_open_mouth" + "express_tongue_out";
        loc_i = loc_facial_anim_list != [];
        loc_options = llList2List(loc_facial_anim_list, loc_start, ~-loc_end);
    }
    else
    {
        integer loc_type = 20;
        if (ResumeVoid == "[PROP]")
        {
            loc_type = 6;
        }
        loc_i = loc_start;
        while (loc_i < loc_end & loc_i < llGetInventoryNumber(loc_type))
        {
            if (!(llGetInventoryName(loc_type, loc_i) == "[AV]helper"))
            {
                loc_options = loc_options + llGetInventoryName(loc_type, loc_i);
            }
            ++loc_i;
        }
        loc_i = llGetInventoryNumber(loc_type);
    }
    gF = llCeil((float)loc_i / loc_my_number_per_page);
    return loc_options;
}

