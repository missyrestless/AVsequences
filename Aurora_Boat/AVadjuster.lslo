                            B("ADJUST " + D(llList2String(loc_data, 7), "�", "|"));
                        }
                        if (llList2Integer(loc_data, 8))
                        {
                            B("SELECT " + llList2String(loc_data, 8));
                        }
                        if (llList2Integer(loc_data, 9) ^ 2)
                        {
                            B("AMENU " + llList2String(loc_data, 9));
                        }
                        if (llList2Integer(loc_data, 10))
                        {
                            B("HELPER " + llList2String(loc_data, 10));
                        }
                    }
                    B("");
                    if (!((gH != []) < 2 & llList2String(loc_data, 5) == ""))
                    {
                        string loc_SITTER_TEXT;
                        if (!(llList2String(loc_data, 5) == ""))
                        {
                            loc_SITTER_TEXT = "|" + D(llList2String(loc_data, 5), "�", "|");
                        }
                        B("SITTER " + (string)llGetOwnerKey + loc_SITTER_TEXT);
                        B("");
                    }
                    return;
                }
                else if (llGetSubString(llPlaySound, 0, 0) == "{")
                {
                    llPlaySound = D(llPlaySound, "{P:", "{");
                    list loc_parts = llParseStringKeepNulls((string)llParseString2List(llGetSubString(llPlaySound, -~llSubStringIndex(llPlaySound, "}"), 99999), (list)" ", (list)""), (list)"<", []);
                    vector loc_pos2 = (vector)("<" + llList2String(loc_parts, 1));
                    vector loc_rot2 = (vector)("<" + llList2String(loc_parts, 2));
                    string loc_result = "<" + _(loc_pos2.x, 3) + "," + _(loc_pos2.y, 3) + "," + _(loc_pos2.z, 3) + ">";
                    loc_result = loc_result + ("<" + _(loc_rot2.x, 1) + "," + _(loc_rot2.y, 1) + "," + _(loc_rot2.z, 1) + ">");
                    llPlaySound = llGetSubString(llPlaySound, 0, llSubStringIndex(llPlaySound, "}")) + loc_result;
                }
                else if (llGetSubString(llPlaySound, 1, 1) == ":")
                {
                    llPlaySound = D(llPlaySound, "S:P:", "POSE ");
                    llPlaySound = D(llPlaySound, "S:M:", "MENU ");
                    llPlaySound = D(llPlaySound, "S:T:", "TOMENU ");
                    if (llGetSubString(llPlaySound, ((integer)-6), ((integer)-1)) == "|90210")
                    {
                        llPlaySound = D(llPlaySound, "S:B:", "SEQUENCE ");
                        llPlaySound = D(llPlaySound, "|90210", "");
                    }
                    else
                    {
                        llPlaySound = D(llPlaySound, "S:B:", "BUTTON ");
                        if (!~llSubStringIndex(llPlaySound, "�"))
                        {
                            llPlaySound = D(llPlaySound, "|90200", "");
                        }
                    }
                    llPlaySound = D(llPlaySound, "S:", "SYNC ");
                    llPlaySound = D(llPlaySound, "�", "|");
                }
                if (llGetSubString(llPlaySound, ((integer)-1), ((integer)-1)) == "*")
                {
                    llPlaySound = llGetSubString(llPlaySound, 0, ((integer)-2));
                }
                if (llGetSubString(llPlaySound, ((integer)-1), ((integer)-1)) == "|")
                {
                    llPlaySound = llGetSubString(llPlaySound, 0, ((integer)-2));
                }
                if (llGetSubString(llPlaySound, 0, 3) == "MENU")
                {
                    B("");
                }
                B(llPlaySound);
            }
            if (llToUpper == 90100 | llToUpper == 90101)
            {
                if ((llPlaySound = llList2String(loc_data, 1)) == "[DUMP]")
                {
                    if (!(llGetOwnerKey == llGetOwner()))
                    {
                        llRegionSayTo(llGetOwnerKey, 0, "Dumping settings to Owner");
                    }
                    llMessageLinked(((integer)-4), 90020, "0", "");
                }
                if (llPlaySound == "[NEW]")
                {
                    gD = llList2Key(loc_data, 2);
                    IsSaveDue = llList2Integer(loc_data, 0);
                    IsRestoring = "";
                    I();
                }
                if (llPlaySound == "[SAVE]")
                {
                    for (loc_i = 0; loc_i < (gH != []); ++loc_i)
                    {
                        if (!(llList2String(Library, loc_i) == ""))
                        {
                            string loc_type = "SYNC";
                            string loc_temp_pose_name = llList2String(Library, loc_i);
                            if (!llSubStringIndex(llList2String(Library, loc_i), "P:"))
                            {
                                loc_type = "POSE";
                                loc_temp_pose_name = llGetSubString(loc_temp_pose_name, 2, 99999);
                            }
                            llMessageLinked(((integer)-4), 90301, (string)loc_i, llList2String(Library, loc_i) + "|" + llList2String(gG, loc_i) + "|" + llList2String(gM, loc_i) + "|");
                            llSay(0, loc_type + " Saved to memory " + N(loc_i) + ": {" + loc_temp_pose_name + "}" + llList2String(gG, loc_i) + llList2String(gM, loc_i));
                        }
                    }
                    llMessageLinked(((integer)-4), 90005, "", llList2String(loc_data, 2) + ("|" + (string)llGetOwnerKey));
                }
                if (llPlaySound == "[HELPER]")
                {
                    gD = llGetOwnerKey;
                    edefaultlink_message = (integer)llList2String(loc_data, 3);
                    S();
                }
                if (llPlaySound == "[ADJUST]")
                {
                    J();
                }
                return;
            }
            if (llToUpper == 90055 | llToUpper == 90056)
            {
                loc_data = llParseStringKeepNulls(llGetOwnerKey, (list)"|", []);
                Library = llListReplaceList(Library, (list)llList2String(loc_data, 0), loc_one, loc_one);
                gG = llListReplaceList(gG, (list)((vector)llList2String(loc_data, 2)), loc_one, loc_one);
                gM = llListReplaceList(gM, (list)((vector)llList2String(loc_data, 3)), loc_one, loc_one);
                if (gI)
                {
                    llRegionSay(gN, "POS|" + (string)loc_one + "|" + M(loc_one) + "|" + (string)edefaultlink_message + "|" + llList2String(gH, loc_one));
                }
            }
        }
    }

    changed(integer llGetInventoryPermMask)
    {
        if (llGetInventoryPermMask & 32)
        {
            if (edefaultlink_message)
            {
                if (!(llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>))
                {
                    J();
                }
            }
            else if (!~-(gH != []) & llAvatarOnSitTarget() == "00000000-0000-0000-0000-000000000000" | llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>)
            {
                J();
            }
        }
        if (llGetInventoryPermMask & 1)
        {
            R();
            J();
            llResetScript();
        }
    }

    run_time_permissions(integer llGetInventoryPermMask)
    {
        if (llGetPermissions() & 1024)
        {
            llPlaySound("3d09f582-3851-c0e0-f5ba-277ac5c73fb4", ((float)1));
            vector loc_eye = (llGetCameraPos() - llGetPos()) / llGetRot();
            vector loc_at = loc_eye + llRot2Fwd(llGetCameraRot() / llGetRot());
            if (llGetInventoryType("[AV]camera") ^ 10)
            {
                llMessageLinked(((integer)-4), 90011, (string)loc_eye, (string)loc_at);
                llSay(0, "Camera property saved for all sitters in prim (takes effect next sit).");
            }
            else
            {
                llMessageLinked(((integer)-4), 90174, (string)IsSaveDue, (string)loc_eye + "|" + (string)loc_at);
            }
            Q();
        }
    }

    listen(integer llGetInventoryPermMask, string llToUpper, key llPlaySound, string llGetOwnerKey)
    {
        if (llGetInventoryPermMask ^ 5)
        {
            if (llPlaySound == gD)
            {
                if (llGetOwnerKey == "[>>]")
                {
                    ++UThread;
                    if (!(UThread < edefaultrez))
                    {
                        UThread = 0;
                    }
                    H(F(), Pop);
                }
                else if (llGetOwnerKey == "[<<]")
                {
                    --UThread;
                    if (UThread < 0)
                    {
                        UThread = ~-edefaultrez;
                    }
                    H(F(), Pop);
                }
                else if (llGetOwnerKey == "[BACK]")
                {
                    llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                }
                else if (llGetOwnerKey == "[POSE]" | llGetOwnerKey == "[SYNC]")
                {
                    IsRestoring = llGetOwnerKey;
                    gL = [];
                    gK = IsSaveDue;
                    g_ = gK;
                    if (llGetOwnerKey == "[SYNC]")
                    {
                        gK = 0;
                        g_ = ~-(gH != []);
                    }
                    G();
                }
                else if (llGetOwnerKey == "[SUBMENU]")
                {
                    IsRestoring = llGetOwnerKey;
                    llTextBox(gD, "\n\nName your submenu:", gN);
                }
                else if (llGetOwnerKey == "[PROP]")
                {
                    if (llGetInventoryType("[AV]prop") ^ 10)
                    {
                        llSay(0, "For this you need the [AV]prop plugin script.");
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                    else
                    {
                        IsRestoring = llGetOwnerKey;
                        H(F(), "Choose your prop:");
                    }
                }
                else if (llGetOwnerKey == "[FACE]")
                {
                    if (llGetInventoryType("[AV]faces") ^ 10)
                    {
                        llSay(0, "For this you need the [AV]faces plugin script.");
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                    else
                    {
                        IsRestoring = llGetOwnerKey;
                        H(F(), "Choose your facial anim:");
                    }
                }
                else if (llGetOwnerKey == "[CAMERA]")
                {
                    Q();
                }
                else if (llGetOwnerKey == "[CLEAR]")
                {
                    integer loc_i;
                    for (loc_i = 0; loc_i < llGetNumberOfPrims(); ++loc_i)
                    {
                        llSetLinkCamera(loc_i, <((float)0), ((float)0), ((float)0)>, <((float)0), ((float)0), ((float)0)>);
                    }
                    if (llGetInventoryType("[AV]camera") ^ 10)
                    {
                        llSay(0, "Camera property cleared from all prims (takes effect next sit).");
                    }
                    else
                    {
                        llMessageLinked(((integer)-4), 90174, (string)IsSaveDue, "none");
                    }
                    Q();
                }
                else if (llGetOwnerKey == "[SAVE]")
                {
                    llRequestPermissions(llPlaySound, 1024);
                }
                else if (!~llListFindList((list)"[DONE]" + "1" + "2" + "3" + "4" + "5" + "6" + "7" + "8" + "9", (list)llGetOwnerKey) | !~llListFindList((list)"[POSE]" + "[SYNC]" + "[SYNC]2" + "[PROP]" + "[FACE]", (list)IsRestoring))
                {
                    llGetOwnerKey = D(llGetOwnerKey, "\n", "");
                    llGetOwnerKey = D(llGetOwnerKey, "|", "");
                    llGetOwnerKey = llGetSubString(llGetOwnerKey, 0, 22);
                    if (llGetOwnerKey == "")
                    {
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                    else if (IsRestoring == "[SUBMENU]")
                    {
                        llMessageLinked(((integer)-4), 90300, (string)IsSaveDue, "T:" + llGetOwnerKey + "*||");
                        llMessageLinked(((integer)-4), 90300, (string)IsSaveDue, "M:" + llGetOwnerKey + "*||");
                        llSay(0, "MENU Added: '" + llGetOwnerKey + "'" + N(IsSaveDue));
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                    else if (IsRestoring == "[POSE]2" | IsRestoring == "[SYNC]2")
                    {
                        integer loc_start;
                        integer loc_end = gL != [];
                        string loc_type = "SYNC";
                        string loc_prefix;
                        if (IsRestoring == "[POSE]2")
                        {
                            loc_prefix = "P:";
                            loc_type = "POSE";
                            loc_start = IsSaveDue;
                            loc_end = -~IsSaveDue;
                        }
                        integer loc_x;
                        integer loc_i;
                        for (loc_i = loc_start; loc_i < loc_end; ++loc_i)
                        {
                            llSay(0, loc_type + " Added: '" + llGetOwnerKey + "' using anim '" + llList2String(gL, loc_x) + "' to SITTER " + (string)loc_i);
                            llMessageLinked(((integer)-4), 90300, (string)loc_i, loc_prefix + llGetOwnerKey + "|" + llList2String(gL, loc_x) + "|" + llList2String(gG, loc_i) + "|" + llList2String(gM, loc_i));
                            ++loc_x;
                        }
                    }
                    if (!(llGetOwnerKey == "" | !(IsRestoring == "[POSE]2" | IsRestoring == "[SYNC]2")))
                    {
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                }
                else
                {
                    string loc_choice = llList2String(F(), ~-(integer)llGetOwnerKey);
                    if (IsRestoring == "[PROP]")
                    {
                        integer loc_perms = llGetInventoryPermMask(loc_choice, 4);
                        if (loc_perms & 32768)
                        {
                            llMessageLinked(((integer)-4), 90171, (string)IsSaveDue, loc_choice);
                        }
                        else
                        {
                            llSay(0, "Could not add prop '" + loc_choice + "'. Props and their content must be COPY-OK for NEXT owner.");
                        }
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                    else if (IsRestoring == "[FACE]")
                    {
                        llMessageLinked(((integer)-4), 90172, (string)IsSaveDue, loc_choice);
                        llMessageLinked(((integer)-4), 90005, "", (string)gD + ("|" + llList2String(gH, IsSaveDue)));
                    }
                    else if (llGetOwnerKey == "[DONE]")
                    {
                        P();
                    }
                    else if (IsRestoring == "[SYNC]" | IsRestoring == "[POSE]")
                    {
                        gL = gL + loc_choice;
                        E(loc_choice, llList2Key(gH, gK));
                        ++gK;
                        if (g_ < gK)
                        {
                            P();
                        }
                        else
                        {
                            G();
                        }
                    }
                }
            }
            else if (llGetOwnerKey(llPlaySound) == llGetOwner())
            {
                list loc_data = llParseString2List(llGetOwnerKey, (list)"|", []);
                integer loc_num = llList2Integer(loc_data, 1);
                if (llList2String(loc_data, 0) == "REG")
                {
                    gA = llListReplaceList(gA, (list)llPlaySound, loc_num, loc_num);
                    llRegionSay(gN, "POS|" + (string)loc_num + "|" + M(loc_num) + "|" + (string)edefaultlink_message + "|" + llList2String(gH, loc_num));
                }
                else if (llList2String(loc_data, 0) == "MENU")
                {
                    if (llList2Key(loc_data, 2) == gD)
                    {
                        llMessageLinked(((integer)-1), 90005, "", (string)gD + ("|" + llList2String(gH, loc_num)));
                    }
                }
                else if (llList2String(loc_data, 0) == "MOVED")
                {
                    rotation loc_f = llGetRot();
                    vector loc_target_rot = llRot2Euler((rotation)llList2String(loc_data, 3) / loc_f) * 57.29578;
                    vector loc_target_pos = ((vector)llList2String(loc_data, 2) - llGetPos()) / loc_f;
                    if (!((string)loc_target_pos == (string)llList2Vector(gG, loc_num) & (string)loc_target_rot == (string)llList2Vector(gM, loc_num)))
                    {
                        gG = llListReplaceList(gG, (list)loc_target_pos, loc_num, loc_num);
                        gM = llListReplaceList(gM, (list)loc_target_rot, loc_num, loc_num);
                        llMessageLinked(((integer)-4), 90057, (string)loc_num, (string)loc_target_pos + "|" + (string)loc_target_rot);
                    }
                }
                else if (edefaultlink_message)
                {
                    integer loc_sitter = (integer)llGetSubString(llToUpper, -~llSubStringIndex(llToUpper, " "), 99999);
                    if (llList2String(loc_data, 0) == "ANIMA")
                    {
                        llMessageLinked(((integer)-4), 90075, (string)loc_sitter, llList2Key(loc_data, 1));
                    }
                    else if (llList2String(loc_data, 0) == "GETUP")
                    {
                        llMessageLinked(((integer)-4), 90076, (string)loc_sitter, llList2Key(loc_data, 1));
                    }
                }
            }
        }
        else
        {
            if (llGetOwnerKey == "cleanup")
            {
                llRegionSay(gN, "DONEA");
                K("Cleaning \"" + llGetScriptName() + "\" and \"[AV]helper\" from prim " + (string)llGetLinkNumber());
                if (llGetInventoryType("[AV]helper") == 6)
                {
                    llRemoveInventory("[AV]helper");
                }
                llRemoveInventory(llGetScriptName());
            }
            else if (llGetOwnerKey == "targets")
            {
                llMessageLinked(((integer)-4), 90298, "", "");
            }
            else if (llGetOwnerKey == "helper")
            {
                if (!(llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>))
                {
                    llMessageLinked(((integer)-1), 90100, "0|[HELPER]||" + (string)edefaultlink_message, llList2Key(gH, 0));
                }
            }
        }
    }

    on_rez(integer llGetInventoryPermMask)
    {
        llResetScript();
    }
}
