H(list llGetPos, string llGetNumberOfPrims)
{
    gA = llGetNumberOfPrims;
    llGetNumberOfPrims = "\n(Page " + (string)(-~gE) + "/" + (string)gF + ")\n" + llGetNumberOfPrims + "\n\n";
    list loc_menu_items;
    integer loc_i;
    if (llGetPos == [])
    {
        llGetNumberOfPrims = "\nNo items of required type in prim inventory.";
        loc_menu_items = (list)"[BACK]";
    }
    else
    {
        integer loc_cutoff = 65;
        integer loc_all_options_length = llStringLength((string)llGetPos);
        integer loc_total_need_to_cut = 412 + -loc_all_options_length;
        if (loc_total_need_to_cut < 0)
        {
            loc_cutoff = 43;
        }
        for (loc_i = 0; loc_i < (llGetPos != []); ++loc_i)
        {
            loc_menu_items = loc_menu_items + (string)(-~loc_i);
            string loc_item = llList2String(llGetPos, loc_i);
            if (loc_cutoff < llStringLength(loc_item))
            {
                loc_item = llGetSubString(loc_item, 0, loc_cutoff) + "..";
            }
            llGetNumberOfPrims = llGetNumberOfPrims + ((string)(-~loc_i) + "." + loc_item + "\n");
        }
        if (ResumeVoid == "[SYNC]" & 1 < gR)
        {
            loc_menu_items = loc_menu_items + "[DONE]";
        }
        loc_menu_items = loc_menu_items + "[BACK]" + "[<<]" + "[>>]";
    }
    llDialog(LslLibrary, llGetNumberOfPrims, llList2List(loc_menu_items, ((integer)-3), ((integer)-1)) + llList2List(loc_menu_items, ((integer)-6), ((integer)-4)) + llList2List(loc_menu_items, ((integer)-9), ((integer)-7)) + llList2List(loc_menu_items, ((integer)-12), ((integer)-10)), System);
}

