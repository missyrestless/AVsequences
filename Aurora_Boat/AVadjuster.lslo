                if (llRequestPermissions == "[>>]")
                {
                    ++gE;
                    if (!(gE < gF))
                    {
                        gE = 0;
                    }
                    H(F(), gA);
                }
                else if (llRequestPermissions == "[<<]")
                {
                    --gE;
                    if (gE < 0)
                    {
                        gE = ~-gF;
                    }
                    H(F(), gA);
                }
                else if (llRequestPermissions == "[BACK]")
                {
                    llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                }
                else if (llRequestPermissions == "[POSE]" | llRequestPermissions == "[SYNC]")
                {
                    ResumeVoid = llRequestPermissions;
                    IsRestoring = [];
                    gR = edefaultrez;
                    edefaultlink_message = gR;
                    if (llRequestPermissions == "[SYNC]")
                    {
                        gR = 0;
                        edefaultlink_message = ~-(gP != []);
                    }
                    G();
                }
                else if (llRequestPermissions == "[SUBMENU]")
                {
                    ResumeVoid = llRequestPermissions;
                    llTextBox(LslLibrary, "\n\nName your submenu:", System);
                }
                else if (llRequestPermissions == "[PROP]")
                {
                    if (llGetInventoryType("[AV]prop") ^ 10)
                    {
                        llSay(0, "For this you need the [AV]prop plugin script.");
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                    else
                    {
                        ResumeVoid = llRequestPermissions;
                        H(F(), "Choose your prop:");
                    }
                }
                else if (llRequestPermissions == "[FACE]")
                {
                    if (llGetInventoryType("[AV]faces") ^ 10)
                    {
                        llSay(0, "For this you need the [AV]faces plugin script.");
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                    else
                    {
                        ResumeVoid = llRequestPermissions;
                        H(F(), "Choose your facial anim:");
                    }
                }
                else if (llRequestPermissions == "[CAMERA]")
                {
                    Q();
                }
                else if (llRequestPermissions == "[CLEAR]")
                {
                    integer loc_i;
                    for (loc_i = 0; loc_i < llGetNumberOfPrims(); ++loc_i)
                    {
                        llSetLinkCamera(loc_i, <((float)0), ((float)0), ((float)0)>, <((float)0), ((float)0), ((float)0)>);
                    }
                    if (llGetInventoryType("[AV]camera") ^ 10)
                    {
                        llSay(0, "Camera property cleared from all prims (takes effect next sit).");
                    }
                    else
                    {
                        llMessageLinked(((integer)-4), 90174, (string)edefaultrez, "none");
                    }
                    Q();
                }
                else if (llRequestPermissions == "[SAVE]")
                {
                    llRequestPermissions(llRot2Fwd, 1024);
                }
                else if (!~llListFindList((list)"[DONE]" + "1" + "2" + "3" + "4" + "5" + "6" + "7" + "8" + "9", (list)llRequestPermissions) | !~llListFindList((list)"[POSE]" + "[SYNC]" + "[SYNC]2" + "[PROP]" + "[FACE]", (list)ResumeVoid))
                {
                    llRequestPermissions = D(llRequestPermissions, "\n", "");
                    llRequestPermissions = D(llRequestPermissions, "|", "");
                    llRequestPermissions = llGetSubString(llRequestPermissions, 0, 22);
                    if (llRequestPermissions == "")
                    {
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                    else if (ResumeVoid == "[SUBMENU]")
                    {
                        llMessageLinked(((integer)-4), 90300, (string)edefaultrez, "T:" + llRequestPermissions + "*||");
                        llMessageLinked(((integer)-4), 90300, (string)edefaultrez, "M:" + llRequestPermissions + "*||");
                        llSay(0, "MENU Added: '" + llRequestPermissions + "'" + N(edefaultrez));
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                    else if (ResumeVoid == "[POSE]2" | ResumeVoid == "[SYNC]2")
                    {
                        integer loc_start;
                        integer loc_end = IsRestoring != [];
                        string loc_type = "SYNC";
                        string loc_prefix;
                        if (ResumeVoid == "[POSE]2")
                        {
                            loc_prefix = "P:";
                            loc_type = "POSE";
                            loc_start = edefaultrez;
                            loc_end = -~edefaultrez;
                        }
                        integer loc_x;
                        integer loc_i;
                        for (loc_i = loc_start; loc_i < loc_end; ++loc_i)
                        {
                            llSay(0, loc_type + " Added: '" + llRequestPermissions + "' using anim '" + llList2String(IsRestoring, loc_x) + "' to SITTER " + (string)loc_i);
                            llMessageLinked(((integer)-4), 90300, (string)loc_i, loc_prefix + llRequestPermissions + "|" + llList2String(IsRestoring, loc_x) + "|" + llList2String(gH, loc_i) + "|" + llList2String(edefaultchanged, loc_i));
                            ++loc_x;
                        }
                    }
                    if (!(llRequestPermissions == "" | !(ResumeVoid == "[POSE]2" | ResumeVoid == "[SYNC]2")))
                    {
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                }
                else
                {
                    string loc_choice = llList2String(F(), ~-(integer)llRequestPermissions);
                    if (ResumeVoid == "[PROP]")
                    {
                        integer loc_perms = llGetInventoryPermMask(loc_choice, 4);
                        if (loc_perms & 32768)
                        {
                            llMessageLinked(((integer)-4), 90171, (string)edefaultrez, loc_choice);
                        }
                        else
                        {
                            llSay(0, "Could not add prop '" + loc_choice + "'. Props and their content must be COPY-OK for NEXT owner.");
                        }
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                    else if (ResumeVoid == "[FACE]")
                    {
                        llMessageLinked(((integer)-4), 90172, (string)edefaultrez, loc_choice);
                        llMessageLinked(((integer)-4), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, edefaultrez)));
                    }
                    else if (llRequestPermissions == "[DONE]")
                    {
                        P();
                    }
                    else if (ResumeVoid == "[SYNC]" | ResumeVoid == "[POSE]")
                    {
                        IsRestoring = IsRestoring + loc_choice;
                        E(loc_choice, llList2Key(gP, gR));
                        ++gR;
                        if (edefaultlink_message < gR)
                        {
                            P();
                        }
                        else
                        {
                            G();
                        }
                    }
                }
            }
            else if (llGetOwnerKey(llRot2Fwd) == llGetOwner())
            {
                list loc_data = llParseString2List(llRequestPermissions, (list)"|", []);
                integer loc_num = llList2Integer(loc_data, 1);
                if (llList2String(loc_data, 0) == "REG")
                {
                    gD = llListReplaceList(gD, (list)llRot2Fwd, loc_num, loc_num);
                    llRegionSay(System, "POS|" + (string)loc_num + "|" + M(loc_num) + "|" + (string)IsSaveDue + "|" + llList2String(gP, loc_num));
                }
                else if (llList2String(loc_data, 0) == "MENU")
                {
                    if (llList2Key(loc_data, 2) == LslLibrary)
                    {
                        llMessageLinked(((integer)-1), 90005, "", (string)LslLibrary + ("|" + llList2String(gP, loc_num)));
                    }
                }
                else if (llList2String(loc_data, 0) == "MOVED")
                {
                    rotation loc_f = llGetRot();
                    vector loc_target_rot = llRot2Euler((rotation)llList2String(loc_data, 3) / loc_f) * 57.29578;
                    vector loc_target_pos = ((vector)llList2String(loc_data, 2) - llGetPos()) / loc_f;
                    if (!((string)loc_target_pos == (string)llList2Vector(gH, loc_num) & (string)loc_target_rot == (string)llList2Vector(edefaultchanged, loc_num)))
                    {
                        gH = llListReplaceList(gH, (list)loc_target_pos, loc_num, loc_num);
                        edefaultchanged = llListReplaceList(edefaultchanged, (list)loc_target_rot, loc_num, loc_num);
                        llMessageLinked(((integer)-4), 90057, (string)loc_num, (string)loc_target_pos + "|" + (string)loc_target_rot);
                    }
                }
                else if (IsSaveDue)
                {
                    integer loc_sitter = (integer)llGetSubString(llGetNumberOfPrims, -~llSubStringIndex(llGetNumberOfPrims, " "), 99999);
                    if (llList2String(loc_data, 0) == "ANIMA")
                    {
                        llMessageLinked(((integer)-4), 90075, (string)loc_sitter, llList2Key(loc_data, 1));
                    }
                    else if (llList2String(loc_data, 0) == "GETUP")
                    {
                        llMessageLinked(((integer)-4), 90076, (string)loc_sitter, llList2Key(loc_data, 1));
                    }
                }
            }
        }
        else
        {
            if (llRequestPermissions == "cleanup")
            {
                llRegionSay(System, "DONEA");
                K("Cleaning \"" + llGetScriptName() + "\" and \"[AV]helper\" from prim " + (string)llGetLinkNumber());
                if (llGetInventoryType("[AV]helper") == 6)
                {
                    llRemoveInventory("[AV]helper");
                }
                llRemoveInventory(llGetScriptName());
            }
            else if (llRequestPermissions == "targets")
            {
                llMessageLinked(((integer)-4), 90298, "", "");
            }
            else if (llRequestPermissions == "helper")
            {
                if (!(llGetAgentSize(llGetLinkKey(llGetNumberOfPrims())) == <((float)0), ((float)0), ((float)0)>))
                {
                    llMessageLinked(((integer)-1), 90100, "0|[HELPER]||" + (string)IsSaveDue, llList2Key(gP, 0));
                }
            }
        }
    }

    on_rez(integer llGetPos)
    {
        llResetScript();
    }
}
