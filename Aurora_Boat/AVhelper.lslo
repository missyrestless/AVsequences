integer LslLibrary;
list System = 
    [ <1, 0.5, 1>
    , <0.5, 0.5, 1>
    , <1, 0.5, 0.5>
    , <0.5, 1, 0.5>
    , <1, 1, 0.5>
    , <0.5, 1, 1>
    ];
integer edefaultrez;
float gB = 0;
integer gA;
key g_;
integer LslUserScript;
vector edefaultchanged = <0, 0, 0>;
rotation Pop = <0, 0, 0, 1>;
list UThread = [g_];

_()
{
    if (llAvatarOnSitTarget())
    {
        if (llGetPermissions() & 16)
        {
            if (!(llGetAgentSize(llGetPermissionsKey()) == <((float)0), ((float)0), ((float)0)>))
            {
                list loc_anims = llGetAnimationList(llGetPermissionsKey());
                integer loc_n;
                for (loc_n = 0; loc_n < (loc_anims != []); ++loc_n)
                {
                    llStopAnimation(llList2String(loc_anims, loc_n));
                }
            }
        }
    }
}

A()
{
    string loc_text = "▽";
    integer loc_i;
    string loc_t = "SITTER";
    if (llGetStartParameter() < ((integer)-1000000000))
    {
        loc_t = "PRIM";
    }
    for (loc_i = 0; loc_i < gA % 5; ++loc_i)
    {
        loc_text = loc_text + "\n \n ";
    }
    loc_text = loc_t + " " + (string)edefaultrez + "\n" + loc_text;
    llSetText(loc_text, llList2Vector(System, edefaultrez % (System != [])), 1);
}

B()
{
    gB = llList2Float(llGetPrimitiveParams((list)18 + 0), 1);
    g_ = llList2Key(UThread, 0);
    UThread = [];
    vector loc_size = <0.12, 0.12, 3.5>;
    if (!(llGetCreator() == llGetInventoryCreator(llGetScriptName())))
    {
        loc_size = llGetScale();
    }
    integer loc_i;
    for (loc_i = 0; loc_i < gA; ++loc_i)
    {
        loc_size = loc_size - <0.001, 0.001, ((float)0)>;
    }
    A();
    llSetObjectName("[AV]helper " + (string)edefaultrez);
    if (llGetCreator() == llGetInventoryCreator(llGetScriptName()))
    {
        llSetLinkPrimitiveParamsFast(((integer)-4), (list)9 + 0 + 0 + <((float)0), ((float)1), ((float)0)> + 0 + <((float)0), ((float)0), ((float)0)> + <((float)1), ((float)1), ((float)0)> + <((float)0), ((float)0), ((float)0)> + 17 + ((integer)-1) + "5748decc-f629-461c-9a36-a35a221fe21f" + <((float)1), ((float)1), ((float)0)> + <((float)0), ((float)0), ((float)0)> + 0 + 18 + ((integer)-1) + llList2Vector(System, edefaultrez % (System != [])) + gB + 18 + 1 + <((float)1), ((float)1), ((float)1)> + gB + 18 + 3 + <((float)1), ((float)1), ((float)1)> + gB + 7 + loc_size);
    }
    else
    {
        llSetLinkPrimitiveParamsFast(((integer)-4), (list)18 + ((integer)-1) + llList2Vector(System, edefaultrez % (System != [])) + gB + 7 + loc_size);
    }
    llRegionSay(LslUserScript, "REG|" + (string)gA);
}

default
{
    state_entry()
    {
        llSetText("", <((float)1), ((float)1), ((float)1)>, 1);
        llSetObjectName("[AV]helper");
        if (llGetCreator() == llGetInventoryCreator(llGetScriptName()))
        {
            llSetLinkPrimitiveParamsFast(((integer)-4), (list)17 + ((integer)-1) + "5748decc-f629-461c-9a36-a35a221fe21f" + <((float)1), ((float)1), ((float)0)> + <((float)0), ((float)0), ((float)0)> + 0 + 20 + ((integer)-1) + 1 + 18 + ((integer)-1) + llList2Vector(System, 0) + 0.7 + 25 + ((integer)-1) + ((float)0));
        }
        else
        {
            llSetLinkPrimitiveParamsFast(((integer)-4), (list)17 + ((integer)-1) + "5748decc-f629-461c-9a36-a35a221fe21f" + <((float)1), ((float)1), ((float)0)> + <((float)0), ((float)0), ((float)0)> + 0 + 20 + ((integer)-1) + 1);
        }
        integer loc_everyonePerms = llGetObjectPermMask(3);
        if (!(loc_everyonePerms & 524288 | !(llGetOwner() == llGetInventoryCreator(llGetScriptName()))))
        {
            llOwnerSay("WARNING! AVhelper should be set to 'Anyone Can Move'");
        }
        llSitTarget(<(-(float)0), (-(float)0), ((float)-0.35)>, <((float)0), ((float)0), ((float)0), ((float)1)>);
        llSetStatus(16, 1);
    }

    on_rez(integer llGetPos)
    {
        llResetTime();
        llSetClickAction(0);
        if (llGetPos)
        {
            edefaultrez = -llGetPos % 1000;
            gA = edefaultrez;
            if (llGetPos < ((integer)-1000000000))
            {
                edefaultrez = gA = 0;
            }
            LslUserScript = llFloor(llGetPos / 1000) * 1000;
            llListen(5, "", "", "");
            llListen(LslUserScript, "", "", "");
            B();
        }
        else
        {
            llSetTimerEvent(0);
            llSetText("", <((float)1), ((float)1), ((float)1)>, 1);
            if (llGetCreator() == llGetInventoryCreator(llGetScriptName()))
            {
                llSetLinkPrimitiveParamsFast(((integer)-4), (list)7 + <0.2, 0.2, 0.2>);
            }
        }
    }

    listen(integer llGetPos, string llSetObjectName, key llGetStartParameter, string llGetOwner)
    {
        if (llGetPos == 5 & llGetStartParameter == g_)
        {
            key loc_av = (key)llGetOwner;
            if (loc_av)
            {
                if (llGetAgentSize(loc_av) == <((float)0), ((float)0), ((float)0)>)
                {
                    llRegionSayTo(llGetStartParameter, 0, "Avatar not found nearby.");
                }
                else
                {
                    list loc_avatar_location = llGetObjectDetails(loc_av, (list)3 + 4);
                    if (llVecMag(llGetPos() - llList2Vector(loc_avatar_location, 0)) < 10)
                    {
                        llSetLinkPrimitiveParamsFast(((integer)-4), (list)6 + llList2Vector(loc_avatar_location, 0) + 8 + llList2Rot(loc_avatar_location, 1));
                    }
                    else
                    {
                        llRegionSayTo(llGetStartParameter, 0, "Avatar too far away.");
                    }
                }
            }
        }
        if (llGetOwnerKey(llGetStartParameter) == llGetOwner())
        {
            list loc_data = llParseString2List(llGetOwner, (list)"|", []);
            if (llList2String(loc_data, 0) == "DONE" & llList2Integer(loc_data, 1) == gA | llList2String(loc_data, 0) == "DONEA")
            {
                if (LslLibrary)
                {
                    if (llAvatarOnSitTarget())
                    {
                        _();
                        llRegionSay(LslUserScript, "GETUP");
                    }
                }
                llDie();
            }
            else if (llList2String(loc_data, 0) == "SWAP")
            {
                integer loc_one = (integer)llList2String(loc_data, 1);
                integer loc_two = (integer)llList2String(loc_data, 2);
                if (gA ^ loc_one)
                {
                    if (gA == loc_two)
                    {
                        gA = edefaultrez = loc_one;
                        B();
                    }
                }
                else
                {
                    gA = edefaultrez = loc_two;
                    B();
                }
            }
            else if (llList2Integer(loc_data, 1) == gA)
            {
                if (llList2String(loc_data, 0) == "POS")
                {
                    vector loc_pos = (vector)llList2String(loc_data, 2);
                    rotation loc_rot = (rotation)llList2String(loc_data, 3);
                    LslLibrary = (integer)llList2String(loc_data, 4);
                    g_ = (key)llList2String(loc_data, 5);
                    if (LslLibrary)
                    {
                        llSetClickAction(1);
                    }
                    llSetLinkPrimitiveParamsFast(((integer)-4), (list)6 + loc_pos + 8 + loc_rot);
                    if (!(llGetPos() == loc_pos))
                    {
                        llSetRegionPos(loc_pos);
                    }
                    edefaultchanged = llGetPos();
                    Pop = llGetRot();
                    llSetTimerEvent(0.01);
                }
            }
        }
    }

    timer()
    {
        if (edefaultchanged == llGetPos() & Pop == llGetRot())
        {
            if (86400 < llGetTime())
            {
                llDie();
            }
        }
        else
        {
            edefaultchanged = llGetPos();
            Pop = llGetRot();
            llRegionSay(LslUserScript, "MOVED|" + (string)gA + "|" + (string)edefaultchanged + "|" + (string)Pop);
        }
    }

    changed(integer llGetPos)
    {
        if (llGetPos & 32)
        {
            key loc_av = llAvatarOnSitTarget();
            if (LslLibrary)
            {
                if (loc_av)
                {
                    llRequestPermissions(loc_av, 16);
                    llRegionSay(LslUserScript, "ANIMA|" + (string)loc_av);
                }
                else
                {
                    _();
                    llRegionSay(LslUserScript, "GETUP");
                    g_ = "";
                }
            }
            else if (loc_av)
            {
                llUnSit(loc_av);
                llDialog(loc_av, "AVhelper 2.2p04\n\nDo not sit on the helper with AVsitter2 unless you have enabled the old helper mode. Move the helper while sitting on the furniture. Please see instructions at http://avsitter.com", [], ((integer)-68154283));
            }
        }
    }

    touch_start(integer llGetPos)
    {
        if (llGetStartParameter())
        {
            llRegionSay(LslUserScript, "MENU|" + (string)gA + "|" + (string)llDetectedKey(0));
        }
    }

    run_time_permissions(integer llGetPos)
    {
        if (llGetPos & 16)
        {
            llStopAnimation("sit");
        }
    }
}
